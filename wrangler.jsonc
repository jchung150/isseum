{
  // Cloudflare Workers, static assets only. Since the /booking form and its
  // /api/booking endpoint were removed (2026-11, bookings go through Naver
  // Booking), nothing runs on demand: there is no Worker script, and every
  // request is served straight off the edge from ./dist.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isseum",
  "compatibility_date": "2026-08-16",

  "assets": {
    "directory": "./dist",
    // Astro is configured with trailingSlash: 'never', so /rules/ must resolve
    // to /rules rather than both being served.
    "html_handling": "drop-trailing-slash",
    // Serves the nearest 404.html up the path, so misses under /en/ get
    // en/404.html (emitted by the localized-404 hook in astro.config.mjs).
    "not_found_handling": "404-page"
  },

  // Custom domains declared here instead of clicked in the dashboard: every
  // `wrangler deploy` reconciles them, and the DNS records are created for us.
  "routes": [
    { "pattern": "www.isseum.com", "custom_domain": true },
    { "pattern": "isseum.com", "custom_domain": true }
  ]
}
