{
  // Cloudflare Workers Static Assets. There is no Worker script — no `main` key —
  // so this deploys dist/ as a pure static site. Cloudflare no longer offers the
  // Pages flow for new projects, which is why this file exists.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isseum",
  "compatibility_date": "2026-08-16",
  // Custom domains declared here instead of clicked in the dashboard: every
  // `wrangler deploy` reconciles them, and the DNS records are created for us.
  // Requires the isseum.com zone to be Active in the same account.
  "routes": [
    { "pattern": "www.isseum.com", "custom_domain": true },
    { "pattern": "isseum.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Astro is configured with trailingSlash: 'never', so /rules/ must resolve
    // to /rules rather than serving both. Keeps canonical URLs unambiguous.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
