---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business, naverMapUrl, naverSiteVerification, site, socialLinks } from '../config/site';
import { CLOSE_HOUR, OPEN_HOUR } from '../data/booking';
import { rates } from '../data/pricing';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  /** Set true on the home page so the title isn't doubled up. */
  isHome?: boolean;
  /** Keep the page out of search results while it's unfinished. */
  noindex?: boolean;
}

const { title, description = site.description, isHome = false, noindex = false } = Astro.props;

const fullTitle = isHome
  ? `${site.name} ISSEUM — 홍대 복합문화공간 대관`
  : `${title} | ${site.name} ISSEUM`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Absolute URL required — Kakao, Slack and Facebook won't resolve a relative one.
const ogImage = new URL('/og-image.jpg', Astro.site).href;

const hhmm = (h: number) => `${String(h).padStart(2, '0')}:00`;
/** 시간당 요금 범위. pricing.ts에서 계산하므로 요금이 바뀌면 따라온다. */
const prices = rates.map((rate) => rate.price);

// 구조화 데이터. EventVenue는 Place의 하위 타입이라 영업시간·가격대 같은 사업체
// 속성을 받지 못한다. LocalBusiness를 함께 선언해 두 쪽 모두 유효하게 만든다 —
// 지역 검색과 지도 노출이 이 사이트에는 일반 웹 검색만큼 중요하다.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['EventVenue', 'LocalBusiness'],
  name: `${site.name} ISSEUM`,
  description: site.description,
  url: Astro.site?.href,
  image: ogImage,
  telephone: business.phone,
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '월드컵북로 22, 지하 1층',
    addressLocality: '마포구',
    addressRegion: '서울특별시',
    addressCountry: 'KR',
  },
  // 같은 주체임을 검색엔진에 연결해 주는 계정들. config/site.ts가 단일 원천이다.
  sameAs: socialLinks.map((link) => link.href),
  hasMap: naverMapUrl,
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday',
    ],
    opens: hhmm(OPEN_HOUR),
    closes: hhmm(CLOSE_HOUR),
  },
  priceRange: `₩${Math.min(...prices).toLocaleString('en-US')}–₩${Math.max(...prices).toLocaleString('en-US')}`,
  maximumAttendeeCapacity: 90,
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="naver-site-verification" content={naverSiteVerification} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name} ISSEUM`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="이씀 ISSEUM — 홍대 복합문화공간 대관" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FBFBF9" />

    <!-- TODO: self-host + subset these. Korean webfonts are heavy and the CDN is a
         third-party dependency on every page load. See design/TOKENS.md §9. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a href="#main" class="skip-link">본문으로 건너뛰기</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
