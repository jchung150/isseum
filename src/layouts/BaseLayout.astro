---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business, site } from '../config/site';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  /** Set true on the home page so the title isn't doubled up. */
  isHome?: boolean;
}

const { title, description = site.description, isHome = false } = Astro.props;

const fullTitle = isHome
  ? `${site.name} ISSEUM — 홍대 복합문화공간 대관`
  : `${title} | ${site.name} ISSEUM`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// LocalBusiness structured data — matters for a venue, and for Naver/Google local results.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EventVenue',
  name: `${site.name} ISSEUM`,
  description: site.description,
  url: Astro.site?.href,
  telephone: business.phone,
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '월드컵북로 22, 지하 1층',
    addressLocality: '마포구',
    addressRegion: '서울특별시',
    addressCountry: 'KR',
  },
  maximumAttendeeCapacity: 60,
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name} ISSEUM`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- TODO: self-host + subset these. Korean webfonts are heavy and the CDN is a
         third-party dependency on every page load. See design/TOKENS.md §9. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a href="#main" class="skip-link">본문으로 건너뛰기</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
