---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { guideGroups, page } from '../../data/guide';

// 번호는 그룹을 가로질러 이어진다 — 01부터 11까지가 매뉴얼 전체다.
let n = 0;
---

<BaseLayout title={page.title} description={page.description}>
  <PageHero eyebrow={page.eyebrow} title={page.heading} lead={page.lead} />

  <nav class="container toc" aria-label={page.tocLabel}>
    {
      guideGroups.map((group) => (
        <section class="group">
          <h2 class="group__title">{group.title}</h2>
          <ol class="toc__list">
            {group.pages.map((section) => {
              n += 1;
              return (
                <li class="toc__item">
                  <a class="toc__link" href={`/guide/${section.slug}`}>
                    <span class="mono-num toc__num">{String(n).padStart(2, '0')}</span>
                    <span class="toc__title">
                      {section.title}
                      {section.required && <span class="must">{page.requiredLabel}</span>}
                    </span>
                    <span class="toc__mark" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </nav>

</BaseLayout>

<style>
  .toc {
    margin-top: var(--space-header-gap);
  }

  .group + .group {
    margin-top: var(--space-section-sm);
  }

  .group__title {
    font-size: var(--text-item-title);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    color: var(--ink);
    padding-bottom: var(--space-4);
  }

  /* 한 줄에 하나씩. 목차 항목 전체가 탭 영역이 되어야 모바일에서 누르기 쉽다. */
  .toc__list {
    border-top: var(--border-hairline);
  }

  .toc__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: var(--border-hairline);
    transition: background var(--transition-fast);
  }

  .toc__link:hover {
    background: var(--surface);
  }

  .toc__num {
    flex: none;
    width: 26px;
  }

  .toc__title {
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-list-name);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    color: var(--ink);
  }

  /* 액센트 색이 없는 사이트라 강조는 잉크 면으로 한다 — 요금의 특가 배지와
     같은 방식. 세 곳에만 붙어서 눈에 걸린다. */
  .must {
    flex: none;
    padding: 3px 8px;
    background: var(--ink);
    color: var(--bg);
    border-radius: var(--radius);
    font-size: var(--text-fine);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
  }

  .toc__mark {
    flex: none;
    color: var(--text-tertiary);
    font-size: var(--text-ui);
  }

  .toc__link:hover .toc__mark {
    color: var(--ink);
  }
</style>
