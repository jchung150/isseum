---
/** Every guide section, generated from the tree in data/ko/guide.ts. */
import GuideDoc from '../../components/sub/GuideDoc.astro';
import { content } from '../../data';
import { flatten, type GuideEntry } from '../../data/guide-tree';

export function getStaticPaths() {
  return flatten(content.ko.guide).map((entry) => ({
    params: { slug: entry.path.replace('/guide/', '') },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: GuideEntry };
---

<GuideDoc lang="ko" entry={entry} />
