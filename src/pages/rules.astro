---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BulletList from '../components/BulletList.astro';
import Button from '../components/Button.astro';
import { bookingUrl } from '../config/site';
import {
  agreement,
  intro,
  lastRevised,
  policyGroups,
  refundSection,
  totalItems,
} from '../data/rules';

// Numbering is derived here so the TOC, the headings and the count can never
// disagree — the export hardcoded all three and they had drifted apart.
const numbered = policyGroups.map((group, gi) => ({
  ...group,
  num: String(gi + 1).padStart(2, '0'),
}));

const refundNum = String(policyGroups.length + 1).padStart(2, '0');

let itemCounter = 0;
const groupsWithItems = numbered.map((group) => ({
  ...group,
  items: group.items.map((item) => ({ ...item, n: ++itemCounter })),
}));
const closingItemNumber = itemCounter + 1;

const toc = [
  ...numbered.map((group) => ({ num: group.num, label: group.title, href: `#${group.id}` })),
  { num: refundNum, label: refundSection.title, href: `#${refundSection.id}` },
];
---

<BaseLayout
  title="대관 규정"
  description="이씀 대관 규정 및 이용 안내. 예약 전 이용 시간, 반입 규정, 원상복구, 취소 및 환불 정책을 확인해 주세요."
>
  <PageHero
    eyebrow={intro.eyebrow}
    title={intro.headline}
    meta={`최종 개정 ${lastRevised} · 총 ${totalItems}개 항목`}
  >
    <Fragment slot="lead">
      <p class="lead">{intro.body}</p>
      <p class="lead intro__emphasis">{intro.emphasis}</p>
    </Fragment>
  </PageHero>

  <div class="container doc">
    <aside class="toc">
      <div class="toc__inner">
        <p class="eyebrow eyebrow--label toc__label">목차</p>
        <nav class="toc__nav" aria-label="대관 규정 목차">
          {
            toc.map((entry) => (
              <a href={entry.href} class="toc__link">
                <span class="mono-num">{entry.num}</span>
                {entry.label}
              </a>
            ))
          }
        </nav>
        <Button href={bookingUrl} external variant="primary" size="block" class="toc__cta">
          대관 예약하기
        </Button>
      </div>
    </aside>

    <div class="doc__body">
      {
        groupsWithItems.map((group) => (
          <section id={group.id} class="group">
            <div class="group__head">
              <span class="mono-num group__num">{group.num}</span>
              <h2 class="display group__title">{group.title}</h2>
            </div>
            {group.items.map((item) => (
              <article class="item">
                <div class="item__head">
                  <span class="item__badge">{item.n}</span>
                  <h3 class="item__title">{item.title}</h3>
                </div>
                <div class="item__body">
                  <BulletList lines={item.lines} />
                </div>
              </article>
            ))}
          </section>
        ))
      }

      <section id={refundSection.id} class="group">
        <div class="group__head">
          <span class="mono-num group__num">{refundNum}</span>
          <h2 class="display group__title">{refundSection.title}</h2>
        </div>

        <div class="tiers">
          {
            refundSection.tiers.map((tier) => (
              <div class="tier">
                <p class="tier__when">{tier.when}</p>
                <p class:list={['tier__rate', `tier__rate--${tier.tone}`]}>{tier.rate}</p>
              </div>
            ))
          }
        </div>

        <div class="exceptions">
          <p class="eyebrow eyebrow--label exceptions__label">예외 규정 및 주의사항</p>
          <BulletList lines={refundSection.exceptions} gap="14px" />
        </div>

        <div class="closing-item">
          <div class="item__head">
            <span class="item__badge">{closingItemNumber}</span>
            <div>
              <h3 class="item__title">{refundSection.closingItem.title}</h3>
              <p class="prose closing-item__body">{refundSection.closingItem.body}</p>
            </div>
          </div>
        </div>
      </section>

      {/* Agreement gate. Renders enabled so the link still works without JS —
          the policy says agreement is implied by payment regardless. JS applies
          the gate on load. Never pointer-events:none on an <a>: see CLAUDE.md. */}
      <div class="gate on-ink">
        <label class="gate__label">
          <input type="checkbox" class="gate__checkbox" data-agree />
          <span class="gate__statement">{agreement.statement}</span>
        </label>
        <div class="gate__actions">
          <a
            href={bookingUrl}
            target="_blank"
            rel="noopener"
            class="gate__cta"
            data-gated-cta
          >
            대관 예약하기
          </a>
          <Button href="/events" variant="outline-on-ink" size="lg">지난 행사 보기</Button>
          <p class="gate__hint" role="status" aria-live="polite" data-hint></p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const checkbox = document.querySelector<HTMLInputElement>('[data-agree]');
  const cta = document.querySelector<HTMLAnchorElement>('[data-gated-cta]');
  const hint = document.querySelector<HTMLElement>('[data-hint]');

  const HINT_BEFORE = '동의 후 예약 신청이 가능합니다.';
  const HINT_AFTER = '동의 완료 — 예약 신청서로 이동할 수 있습니다.';

  if (checkbox && cta) {
    const sync = () => {
      const agreed = checkbox.checked;
      // aria-disabled keeps the link focusable and announced, unlike
      // pointer-events:none which silently removes it for keyboard users.
      cta.setAttribute('aria-disabled', String(!agreed));
      cta.classList.toggle('is-disabled', !agreed);
      if (hint) hint.textContent = agreed ? HINT_AFTER : HINT_BEFORE;
    };

    cta.addEventListener('click', (event) => {
      if (!checkbox.checked) {
        event.preventDefault();
        checkbox.focus();
      }
    });

    checkbox.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  /* Second lead paragraph in the PageHero slot — the agreement clause carries
     legal weight, so it stays visually distinct from the sentence above it. */
  .intro__emphasis {
    color: var(--ink);
    font-weight: 600;
  }

  /* ---------- Doc layout ---------- */
  .doc {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-lg);
    padding-bottom: clamp(60px, 8vw, 110px);
  }

  .toc {
    display: none;
  }

  .toc__inner {
    position: sticky;
    top: var(--scroll-offset);
  }

  .toc__label {
    margin: clamp(32px, 4vw, 56px) 0 14px;
  }

  .toc__nav {
    display: flex;
    flex-direction: column;
    border-top: var(--border-hairline);
  }

  .toc__link {
    display: flex;
    gap: 10px;
    padding: 13px 2px;
    border-bottom: var(--border-hairline);
    font-size: var(--text-ui);
    font-weight: 500;
    letter-spacing: var(--tracking-body);
    line-height: 1.4;
  }

  .doc :global(.toc__cta) {
    margin-top: var(--space-5);
  }

  /* ---------- Groups ---------- */
  .group {
    padding-top: var(--space-group);
    scroll-margin-top: 100px;
  }

  .group__head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-bottom: var(--space-5);
    border-bottom: var(--border-hairline);
  }

  .group__num {
    font-size: var(--mono-num-lg);
  }

  .group__title {
    font-size: var(--display-group);
    line-height: 1.25;
  }

  .item {
    padding: clamp(26px, 3vw, 40px) 0;
    border-bottom: var(--border-hairline);
  }

  .item__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .item__badge {
    flex: none;
    width: 26px;
    height: 26px;
    border: var(--border-emphasis);
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .item__title {
    font-size: var(--text-item-title);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
  }

  /* 38px = badge width + gap, so copy aligns under the title, not the number. */
  .item__body {
    padding-left: 38px;
    margin-top: 10px;
  }

  /* ---------- Refund ---------- */
  .tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1px;
    background: var(--border);
    border: var(--border-hairline);
    margin-top: clamp(24px, 3vw, 36px);
  }

  .tier {
    background: var(--bg);
    padding: clamp(22px, 2.4vw, 32px) var(--space-6) clamp(26px, 2.8vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .tier__when {
    font-size: var(--text-ui);
    font-weight: 600;
    color: var(--text-body);
    letter-spacing: var(--tracking-title);
  }

  /* Severity fades rather than turning red — the palette has no accent hue. */
  .tier__rate {
    font-family: var(--font-serif);
    font-size: var(--display-figure);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
  }

  .tier__rate--strong {
    color: var(--ink);
  }
  .tier__rate--medium {
    color: var(--text-strong);
  }
  .tier__rate--muted {
    color: var(--text-secondary);
  }

  .exceptions {
    margin-top: clamp(22px, 2.6vw, 34px);
    background: var(--surface);
    border: var(--border-hairline);
    padding: var(--space-notice);
  }

  .exceptions__label {
    margin-bottom: 18px;
  }

  .closing-item {
    margin-top: clamp(22px, 2.6vw, 34px);
    padding: clamp(24px, 3vw, 36px) 0;
    border-top: var(--border-hairline);
    border-bottom: var(--border-hairline);
  }

  .closing-item__body {
    margin-top: var(--space-3);
  }

  /* ---------- Agreement gate ---------- */
  .gate {
    margin-top: clamp(36px, 4.5vw, 64px);
    background: var(--ink);
    padding: var(--space-panel);
  }

  .gate__label {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    cursor: pointer;
  }

  .gate__checkbox {
    width: var(--space-5);
    height: var(--space-5);
    margin: 2px 0 0;
    accent-color: var(--bg);
    flex: none;
    cursor: pointer;
  }

  .gate__statement {
    font-size: clamp(15px, 1.5vw, 17.5px);
    line-height: 1.7;
    color: var(--bg);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
  }

  .gate__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: clamp(22px, 2.6vw, 32px);
    padding-top: clamp(22px, 2.6vw, 32px);
    border-top: 1px solid var(--ink-hover);
  }

  .gate__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: 17px var(--space-8);
    border-radius: var(--radius);
    letter-spacing: var(--tracking-ui);
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .gate__cta:hover {
    background: var(--border);
    color: var(--ink);
  }

  .gate__cta.is-disabled {
    background: var(--ink-hover);
    color: var(--text-secondary);
    cursor: not-allowed;
  }

  .gate__hint {
    font-size: var(--text-meta);
    color: var(--text-tertiary);
    letter-spacing: var(--tracking-ui);
  }

  @media (min-width: 1100px) {
    .toc {
      display: block;
    }

    .doc {
      grid-template-columns: 236px 1fr;
    }
  }
</style>
