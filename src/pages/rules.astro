---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BulletList from '../components/BulletList.astro';
import Button from '../components/Button.astro';
import { lastRevised, policyGroups, refundSection } from '../data/booking';
import { page } from '../data/rules';
import { bookingUrl } from '../config/site';

// 번호는 저장하지 않고 배열 순서에서 만든다. 항목을 더하거나 빼도 어긋나지 않는다.
let n = 0;
const numbered = policyGroups.map((group) => ({
  ...group,
  items: group.items.map((item) => ({ ...item, n: ++n })),
}));
---

<BaseLayout title={page.title} description={page.description}>
  <PageHero eyebrow={page.eyebrow} title={page.heading} lead={page.lead} meta={`${page.revisedLabel} ${lastRevised}`} />

  <div class="container policy">
    {
      numbered.map((group) => (
        <section class="group">
          <h2 class="group__title">{group.title}</h2>
          {group.items.map((item) => (
            <article class="item">
              <h3 class="item__title">
                <span class="mono-num item__n">{String(item.n).padStart(2, '0')}</span>
                {item.title}
              </h3>
              <div class="item__body">
                {item.lines && <BulletList lines={item.lines} gap="10px" />}
                {item.body && <p class="prose">{item.body}</p>}
              </div>
            </article>
          ))}
        </section>
      ))
    }

    <section class="group">
      <h2 class="group__title">{refundSection.title}</h2>
      <article class="item">
        <div class="item__body item__body--flush">
          <ul class="tiers">
            {
              refundSection.tiers.map((tier) => (
                <li class="tier">
                  <span>{tier.when}</span>
                  <span class="tier__rate">{tier.rate}</span>
                </li>
              ))
            }
          </ul>
          <BulletList lines={refundSection.exceptions} gap="10px" />
        </div>
      </article>
    </section>

    <div class="cta">
      <Button href={bookingUrl} variant="primary" size="lg">{page.ctaLabel}</Button>
    </div>
  </div>
</BaseLayout>

<style>
  .policy {
    padding-top: var(--space-section-sm);
    padding-bottom: var(--space-section-sm);
  }

  .group + .group {
    margin-top: var(--space-section-sm);
  }

  .group__title {
    font-size: var(--text-item-title);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    color: var(--ink);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-emphasis);
  }

  .item {
    padding: var(--space-6) 0;
    border-bottom: var(--border-hairline);
  }

  .item__title {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    font-size: var(--text-list-name);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    color: var(--ink);
  }

  .item__n {
    flex: none;
    width: 26px;
  }

  /* 본문을 번호 너비만큼 들여 제목 글자와 왼쪽을 맞춘다. */
  .item__body {
    margin-top: var(--space-3);
    padding-left: calc(26px + var(--space-4));
    max-width: var(--measure-body);
  }

  .item__body--flush {
    padding-left: 0;
  }

  .tiers {
    margin-bottom: var(--space-5);
    border-top: var(--border-hairline);
  }

  .tier {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 10px 0;
    border-bottom: var(--border-hairline);
    font-size: var(--text-ui);
    color: var(--text-body);
  }

  .tier__rate {
    font-weight: 600;
    color: var(--ink);
  }

  .cta {
    margin-top: var(--space-section-sm);
  }

  @media (max-width: 639px) {
    .item__body {
      padding-left: 0;
    }
  }
</style>
