---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { Image } from 'astro:assets';
import DarkCta from '../components/DarkCta.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import { hero, heroSlides, stats, features, steps } from '../data/home';
import { spaces } from '../data/spaces';
import { equipment } from '../data/equipment';
---

<BaseLayout title="홈" isHome>
  {/* ---------- Hero ---------- */}
  <section class="container hero">
    <HeroSlideshow slides={heroSlides} />
    <div class="hero__body">
      <p class="eyebrow hero__eyebrow">{hero.eyebrow}</p>
      <h1 class="display hero__title">
        {hero.headline}{' '}<em class="hero__brand">{hero.brand}</em>
      </h1>
      <div class="hero__copy">
        {hero.body.map((p) => <p class="lead">{p}</p>)}
      </div>
    </div>
  </section>

  {/* ---------- Stats ----------
      Cells were unauthored in the export (design/COMPONENTS.md §17); built here
      from the existing `stats` data in the design's own idiom. */}
  <section class="container stats-section">
    <dl class="stats">
      {
        stats.map((stat) => (
          <div class="stats__cell">
            <dt class="stats__value">{stat.value}</dt>
            <dd class="stats__label">{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* ---------- Why ISSEUM ---------- */}
  <section class="container section">
    <SectionHeader eyebrow="WHY ISSEUM" title="공간 특징" />
    <div class="why hairline-grid">
      {
        features.map((feature, i) => (
          <article class="why__card">
            <span class="mono-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="display why__title">{feature.title}</h3>
              <p class="why__body">{feature.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* ---------- Space ---------- */}
  <section id="space" class="container section space-section">
    <SectionHeader eyebrow="SPACE & EQUIPMENT" title="공간 안내" />

    <div class="spaces">
      {
        spaces.map((space) => (
          <article class="space">
            <Image
              class="space__photo"
              src={space.src}
              alt={space.alt}
              widths={[400, 700, 1000]}
              sizes="(min-width: 1100px) 25vw, (min-width: 640px) 50vw, 100vw"
              style={`object-position: ${space.focus ?? 'center'};`}
              loading="lazy"
            />
            <div class="space__head">
              <span class="mono-num">{space.num}</span>
              <h3 class="display space__name">{space.name}</h3>
            </div>
            <p class="space__desc">{space.desc}</p>
            <p class="space__meta">{space.meta}</p>
          </article>
        ))
      }
    </div>

    <div class="eq">
      <div class="eq__head">
        <h3 class="display eq__title">보유 장비</h3>
        <a href="/equipment" class="eq__link">
          전체 장비 자세히 보기<span class="eq__arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <ul class="eq__list">
        {
          equipment.map((item, i) => (
            <li class="eq__row">
              <span class="mono-num eq__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="eq__name">{item.summary.name}</span>
              <span class="eq__spec">{item.summary.spec}</span>
            </li>
          ))
        }
      </ul>
      <p class="eq__note">전 장비 대관료에 포함 · 사전 요청 시 세팅 지원</p>
    </div>
  </section>

  {/* ---------- Process ---------- */}
  <section class="container section">
    <SectionHeader eyebrow="RENTAL PROCESS" title="대관 절차" />
    <ol class="steps">
      {
        steps.map((step) => (
          <li class="step">
            <div class="step__head">
              <span class="step__num">{step.num}</span>
              <span class="step__en">{step.en}</span>
            </div>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__body">{step.body}</p>
          </li>
        ))
      }
    </ol>
    <div class="closing">
      <DarkCta
        headline="원하시는 날짜가 비어 있는지 먼저 확인해 보세요."
        sub="신청서 접수 후 영업일 기준 1일 내 회신드립니다."
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-top: clamp(20px, 3vw, 40px);
  }

  .hero__body {
    padding-top: clamp(34px, 5vw, 72px);
  }

  .hero__eyebrow {
    margin-bottom: clamp(20px, 3vw, 34px);
  }

  .hero__title {
    font-size: var(--display-hero);
    line-height: var(--leading-display-relaxed);
    max-width: var(--measure-display);
  }

  .hero__brand {
    font-style: normal;
    color: var(--text-strong);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 1.8vw, 24px);
    margin-top: clamp(22px, 3vw, 36px);
    max-width: var(--measure-lead);
  }

  .hero__copy .lead {
    line-height: var(--leading-body-relaxed);
  }

  /* ---------- Stats ---------- */
  .stats-section {
    padding-top: clamp(28px, 4vw, 52px);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1px;
    background: var(--border);
    border-top: var(--border-hairline);
    border-bottom: var(--border-hairline);
  }

  .stats__cell {
    background: var(--bg);
    padding: clamp(20px, 2.4vw, 30px) var(--space-4) clamp(22px, 2.6vw, 32px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stats__value {
    font-family: var(--font-serif);
    font-size: var(--display-sub);
    font-weight: 500;
    letter-spacing: var(--tracking-title);
    line-height: 1.15;
  }

  .stats__label {
    margin-top: var(--space-3);
    font-size: var(--text-meta);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-meta);
    text-wrap: balance;
  }

  /* ---------- Why ---------- */
  .why {
    grid-template-columns: 1fr;
    margin-top: var(--space-header-gap);
  }

  .why__card {
    padding: var(--space-card);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .why__title {
    font-size: var(--display-card);
    line-height: var(--leading-display-relaxed);
  }

  .why__body {
    margin-top: var(--space-3);
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--text-body);
    letter-spacing: var(--tracking-body);
  }

  /* ---------- Space ---------- */
  .space-section {
    scroll-margin-top: var(--scroll-offset);
  }

  .spaces {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-md);
    margin-top: var(--space-header-gap);
  }

  .space {
    display: flex;
    flex-direction: column;
  }

  .space :global(.space__photo) {
    width: 100%;
    aspect-ratio: var(--ratio-card);
    object-fit: cover;
    border: var(--border-hairline);
    background: var(--surface);
  }

  .space__head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: var(--space-5);
  }

  .space__name {
    font-size: var(--display-card);
    letter-spacing: var(--tracking-title);
  }

  .space__desc {
    margin-top: 11px;
    font-size: var(--text-sm);
    line-height: var(--leading-compact);
    color: var(--text-body);
    letter-spacing: var(--tracking-body);
  }

  .space__meta {
    margin-top: 14px;
    padding-top: 14px;
    border-top: var(--border-hairline);
    font-size: var(--text-meta);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-meta);
  }

  /* ---------- Equipment preview ---------- */
  .eq {
    margin-top: clamp(48px, 6vw, 92px);
    border-top: var(--border-emphasis);
  }

  .eq__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: clamp(22px, 2.6vw, 34px) 0 clamp(18px, 2vw, 26px);
  }

  .eq__title {
    font-size: var(--display-sub);
    letter-spacing: var(--tracking-title);
  }

  .eq__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-ui);
    font-weight: 600;
    letter-spacing: var(--tracking-body);
  }

  .eq__arrow {
    display: inline-block;
    transition: transform var(--transition);
  }

  .eq__link:hover .eq__arrow {
    transform: translateX(5px);
  }

  .eq__list {
    border-top: var(--border-hairline);
  }

  .eq__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding: 15px 0;
    border-bottom: var(--border-hairline);
  }

  .eq__num {
    flex: none;
    width: 26px;
  }

  /* The flex-basis pair is what collapses this to two lines on narrow screens
     without a media query. */
  .eq__name {
    flex: 1 1 260px;
    font-size: var(--text-list-name);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
  }

  .eq__spec {
    flex: 1 1 200px;
    font-size: var(--text-ui);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-ui);
  }

  .eq__note {
    margin-top: var(--space-4);
    font-size: var(--text-meta);
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  /* ---------- Steps ---------- */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    background: var(--border);
    margin-top: var(--space-header-gap);
    border-bottom: var(--border-hairline);
  }

  .step {
    background: var(--bg);
    padding: clamp(24px, 2.6vw, 38px) clamp(20px, 2vw, 30px) clamp(30px, 3.4vw, 48px);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: background var(--transition);
  }

  .step:hover {
    background: var(--surface);
  }

  .step__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .step__num {
    font-family: var(--font-serif);
    font-size: var(--numeral-step);
    font-weight: 400;
    line-height: var(--leading-none);
  }

  .step__en {
    font-size: var(--eyebrow-step-size);
    letter-spacing: var(--tracking-step);
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .step__title {
    margin-top: 22px;
    font-size: var(--text-step-title);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
  }

  .step__body {
    font-size: 14px;
    line-height: var(--leading-compact);
    color: var(--text-body);
    letter-spacing: var(--tracking-body);
  }

  .closing {
    margin-top: clamp(32px, 4vw, 56px);
  }

  /* ---------- Breakpoints (640 / 900 / 1100 — see design/TOKENS.md §4) ---------- */
  @media (min-width: 640px) {
    .spaces {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .why {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .spaces {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
