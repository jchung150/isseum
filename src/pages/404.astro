---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { footerLinks } from '../config/site';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청하신 페이지를 찾을 수 없습니다.">
  <section class="container notfound">
    <p class="eyebrow notfound__eyebrow">404 — NOT FOUND</p>
    <h1 class="display notfound__title">요청하신 페이지를 찾을 수 없습니다.</h1>
    <p class="lead notfound__lead">
      주소가 변경되었거나 삭제된 페이지일 수 있습니다. 아래에서 원하시는 안내를 찾아보세요.
    </p>

    <div class="notfound__actions">
      <Button href="/" variant="primary" size="lg">홈으로 돌아가기</Button>
    </div>

    <nav class="links" aria-label="주요 안내">
      {
        footerLinks.map((link) => (
          <a
            href={link.href}
            class="links__row"
            {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {link.label}
            <span class="links__arrow" aria-hidden="true">{link.external ? '↗' : '→'}</span>
          </a>
        ))
      }
    </nav>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-top: var(--space-section-sm);
    padding-bottom: var(--space-section);
    max-width: var(--measure-body);
  }

  .notfound__eyebrow {
    margin-bottom: clamp(18px, 2.6vw, 32px);
  }

  .notfound__title {
    font-size: var(--display-page);
    line-height: 1.22;
  }

  .notfound__lead {
    margin-top: clamp(20px, 2.6vw, 34px);
    padding-bottom: clamp(24px, 3vw, 36px);
    border-bottom: var(--border-emphasis);
  }

  .notfound__actions {
    margin-top: clamp(28px, 3.4vw, 40px);
  }

  .links {
    display: flex;
    flex-direction: column;
    border-top: var(--border-hairline);
    margin-top: clamp(36px, 4.5vw, 60px);
  }

  .links__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 0;
    border-bottom: var(--border-hairline);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-body);
  }

  .links__arrow {
    color: var(--text-tertiary);
    font-size: var(--text-xs);
  }
</style>
