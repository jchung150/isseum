---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { footerLinks } from '../config/site';
import { notFound } from '../data/notFound';
---

<BaseLayout title={notFound.title} description={notFound.description}>
  <section class="container notfound">
    <p class="eyebrow notfound__eyebrow">{notFound.eyebrow}</p>
    <h1 class="display notfound__title">{notFound.headline}</h1>
    <p class="lead notfound__lead">{notFound.lead}</p>

    <div class="notfound__actions">
      <Button href="/" variant="primary" size="lg">{notFound.home}</Button>
    </div>

    <nav class="links" aria-label={notFound.linksLabel}>
      {
        footerLinks.map((link) => (
          <a
            href={link.href}
            class="links__row"
            {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {link.label}
            <span class="links__arrow" aria-hidden="true">{link.external ? '↗' : '→'}</span>
          </a>
        ))
      }
    </nav>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-top: var(--space-section-sm);
    padding-bottom: var(--space-section);
  }

  /* Measure goes on the children, not the container — putting it on .container
     overrides its max-width and margin-inline:auto then centres the block,
     which breaks the left-aligned rhythm every other page follows. */
  .notfound > * {
    max-width: var(--measure-body);
  }

  .notfound__eyebrow {
    margin-bottom: clamp(18px, 2.6vw, 32px);
  }

  .notfound__title {
    font-size: var(--display-page);
    line-height: 1.22;
  }

  .notfound__lead {
    margin-top: clamp(20px, 2.6vw, 34px);
    padding-bottom: clamp(24px, 3vw, 36px);
    border-bottom: var(--border-emphasis);
  }

  .notfound__actions {
    margin-top: clamp(28px, 3.4vw, 40px);
  }

  .links {
    display: flex;
    flex-direction: column;
    border-top: var(--border-hairline);
    margin-top: clamp(36px, 4.5vw, 60px);
  }

  .links__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 0;
    border-bottom: var(--border-hairline);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-body);
  }

  .links__arrow {
    color: var(--text-tertiary);
    font-size: var(--text-xs);
  }
</style>
