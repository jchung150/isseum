---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BulletList from '../components/BulletList.astro';
import {
  MAX_GUESTS,
  MIN_HOURS,
  OPEN_HOUR,
  CLOSE_HOUR,
  addOns,
  optionsIntro,
  privacy,
  referralSources,
  reviewGroups,
  steps,
} from '../data/booking';
import { business, turnstileSiteKey } from '../config/site';
import { policyGroups, refundSection, lastRevised } from '../data/rules';

// The regulations shown in step 2 come from the same source as /rules, so the
// two can never state different policies.
let itemCounter = 0;
const numberedGroups = policyGroups.map((group) => ({
  ...group,
  items: group.items.map((item) => ({ ...item, n: ++itemCounter })),
}));
const closingItemNumber = itemCounter + 1;

const times = Array.from({ length: CLOSE_HOUR - OPEN_HOUR + 1 }, (_, i) => {
  const h = OPEN_HOUR + i;
  return { value: `${String(h).padStart(2, '0')}:00`, label: `${h}:00` };
});
---

<BaseLayout
  title="대관 예약 신청"
  description="이씀 대관 예약 신청서. 기본 정보와 이용 규정 동의, 추가 옵션을 작성해 주시면 영업일 기준 1일 내에 회신드립니다."
  noindex
>
  <PageHero
    eyebrow="BOOKING REQUEST"
    title="대관 예약 신청"
    lead="아래 내용을 작성해 주시면 영업일 기준 1일 내에 담당자가 연락드립니다. 최종 금액과 예약 확정은 확인 후 안내됩니다."
  />

  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    async
    defer></script>

  <section class="container form-section">
    {/* Turnstile requires JS, so the form as a whole does. Say so plainly and
        give a route that still works. */}
    <noscript>
      <div class="nojs">
        <p><strong>이 신청서는 자바스크립트가 필요합니다.</strong></p>
        <p>
          브라우저에서 자바스크립트를 허용하시거나, 아래로 직접 연락해 주시면 동일하게
          접수해 드립니다.
        </p>
        <p>
          <a href={`tel:${business.phone}`}>{business.phone}</a> ·
          <a href={`mailto:${business.email}`}>{business.email}</a>
        </p>
      </div>
    </noscript>
    {/* Progress. Hidden until JS turns the form into a wizard — without JS all
        four sections are simply visible in order, which still works. */}
    <ol class="progress" data-progress hidden>
      {
        steps.map((step, i) => (
          <li class="progress__item" data-progress-item={i}>
            <span class="mono-num progress__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="progress__label">{step.label}</span>
          </li>
        ))
      }
    </ol>

    {/* Shown in place of the form once the endpoint confirms receipt. */}
    <div class="done" data-success hidden>
      <p class="eyebrow">REQUEST RECEIVED</p>
      <h2 class="done__title">예약 신청이 접수되었습니다.</h2>
      <p class="done__body">
        영업일 기준 1일 내에 담당자가 연락드립니다. 최종 금액과 예약 확정은 확인 후
        안내됩니다.
      </p>
      <p class="done__body">
        급하신 경우 <a href={`tel:${business.phone}`}>{business.phone}</a> 으로 연락 주세요.
      </p>
      <div class="done__actions">
        <a href="/" class="btn btn--ghost">홈으로</a>
      </div>
    </div>

    <form class="form" method="POST" action="/api/booking" data-form data-sitekey={turnstileSiteKey} novalidate>
      {/* ---------------- 1. 기본 정보 ---------------- */}
      <fieldset class="step" data-step="0">
        <legend class="step__legend">
          <span class="eyebrow">STEP 01</span>
          <span class="step__title">행사장 대관 예약자 기본 정보</span>
        </legend>
        <p class="step__hint">예약하시는 분의 기본 정보를 입력해 주세요.</p>

        <div class="grid">
          <p class="field">
            <label class="field__label" for="name">성함 <span class="req">*</span></label>
            <input class="input" type="text" id="name" name="name" required autocomplete="name" placeholder="홍길동" />
          </p>
          <p class="field">
            <label class="field__label" for="org">소속</label>
            <input class="input" type="text" id="org" name="org" autocomplete="organization" placeholder="소속 단체 (선택)" />
          </p>
          <p class="field">
            <label class="field__label" for="phone">전화번호 <span class="req">*</span></label>
            <input class="input" type="tel" id="phone" name="phone" required autocomplete="tel" inputmode="tel" placeholder="010-0000-0000" />
          </p>
          <p class="field">
            <label class="field__label" for="email">이메일 <span class="req">*</span></label>
            <input class="input" type="email" id="email" name="email" required autocomplete="email" placeholder="example@email.com" />
          </p>
          <p class="field">
            <label class="field__label" for="date">대관 날짜 <span class="req">*</span></label>
            <input class="input" type="date" id="date" name="date" required />
          </p>
          <p class="field">
            <label class="field__label" for="guests">
              총 사용 인원 <span class="req">*</span>
            </label>
            <input class="input" type="number" id="guests" name="guests" required min="1" max={MAX_GUESTS} inputmode="numeric" placeholder="명" />
            <span class="field__note">스태프와 게스트를 모두 포함합니다. 최대 {MAX_GUESTS}인.</span>
          </p>
        </div>

        <fieldset class="subfield">
          <legend class="field__label">
            대관 시간 <span class="req">*</span>
            <span class="field__note">최소 {MIN_HOURS}시간</span>
          </legend>
          <div class="timerange">
            <label class="visually-hidden" for="start">시작 시간</label>
            <select class="input" id="start" name="start" required>
              <option value="">시작</option>
              {times.map((t) => <option value={t.value}>{t.label}</option>)}
            </select>
            <span class="timerange__sep" aria-hidden="true">~</span>
            <label class="visually-hidden" for="end">종료 시간</label>
            <select class="input" id="end" name="end" required>
              <option value="">종료</option>
              {times.map((t) => <option value={t.value}>{t.label}</option>)}
            </select>
          </div>
          <span class="field__note" data-duration aria-live="polite"></span>
        </fieldset>

        <p class="field">
          <label class="field__label" for="purpose">대관 설명 <span class="req">*</span></label>
          <textarea class="input input--area" id="purpose" name="purpose" required rows="3"
            placeholder="예) 연말 모임, 워크숍, 팝업스토어, NGO 행사, 크리스마스 파티 등"></textarea>
        </p>

        <fieldset class="subfield">
          <legend class="field__label">
            유입 경로 <span class="req">*</span>
            <span class="field__note">복수 선택 가능</span>
          </legend>
          <div class="chips">
            {
              referralSources.map((source) => (
                <label class="chip">
                  <input type="checkbox" name="referral" value={source} />
                  <span>{source}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
      </fieldset>

      {/* ---------------- 2. 이용 규정 ---------------- */}
      <fieldset class="step" data-step="1">
        <legend class="step__legend">
          <span class="eyebrow">STEP 02</span>
          <span class="step__title">이용 규정 동의</span>
        </legend>
        <p class="step__hint">
          아래 규정을 확인해 주세요. 최종 개정 {lastRevised}
        </p>

        <div class="policy" tabindex="0" role="region" aria-label="대관 규정 전문">
          {
            numberedGroups.map((group) => (
              <section class="policy__group">
                <h3 class="policy__group-title">{group.title}</h3>
                {group.items.map((item) => (
                  <article class="policy__item">
                    <h4 class="policy__item-title">
                      <span class="policy__n">{item.n}</span>
                      {item.title}
                    </h4>
                    <BulletList lines={item.lines} gap="10px" />
                  </article>
                ))}
              </section>
            ))
          }

          <section class="policy__group">
            <h3 class="policy__group-title">{refundSection.title}</h3>
            <ul class="tiers">
              {
                refundSection.tiers.map((tier) => (
                  <li class="tier">
                    <span>{tier.when}</span>
                    <span class="tier__rate">{tier.rate}</span>
                  </li>
                ))
              }
            </ul>
            <div class="policy__item">
              <BulletList lines={refundSection.exceptions} gap="10px" />
            </div>
            <article class="policy__item">
              <h4 class="policy__item-title">
                <span class="policy__n">{closingItemNumber}</span>
                {refundSection.closingItem.title}
              </h4>
              <p class="prose">{refundSection.closingItem.body}</p>
            </article>
          </section>
        </div>

        <label class="consent">
          <input type="checkbox" name="agreeRules" required />
          <span>위 대관 규정 및 환불 정책을 모두 확인하였으며, 이에 동의합니다. <span class="req">*</span></span>
        </label>

      </fieldset>

      {/* ---------------- 3. 추가 옵션 ---------------- */}
      <fieldset class="step" data-step="2">
        <legend class="step__legend">
          <span class="eyebrow">STEP 03</span>
          <span class="step__title">{optionsIntro.title}</span>
        </legend>
        <p class="step__hint">{optionsIntro.body}</p>
        <p class="notice-inline">{optionsIntro.note}</p>

        <div class="options">
          {
            addOns.map((addon) => (
              <label class="option">
                <input type="checkbox" name="addons" value={addon.title} />
                <span class="option__body">
                  <span class="option__head">
                    <span class="option__title">{addon.title}</span>
                    {addon.price && <span class="option__price">{addon.price}</span>}
                  </span>
                  <span class="option__notes">
                    {addon.notes.map((note) => <span class="option__note">{note}</span>)}
                  </span>
                </span>
              </label>
            ))
          }
        </div>

        <p class="field">
          <label class="field__label" for="requests">그 외 요청 사항</label>
          <textarea class="input input--area" id="requests" name="requests" rows="3"
            placeholder="필요한 장비, 세팅 요청, 문의 사항 등을 자유롭게 적어 주세요. (선택)"></textarea>
        </p>
      </fieldset>

      {/* ---------------- 4. 개인정보 동의 ---------------- */}
      <fieldset class="step" data-step="3">
        <legend class="step__legend">
          <span class="eyebrow">STEP 04</span>
          <span class="step__title">개인정보 수집·이용 동의</span>
        </legend>

        <div class="policy policy--privacy" tabindex="0" role="region" aria-label="개인정보 수집·이용 동의 전문">
          <section class="pblock">
            <p class="pblock__lead">{privacy.intro}</p>
            <dl class="pdl">
              {
                privacy.collection.map((row) => (
                  <div class="pdl__row">
                    <dt>{row.term}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="pblock__note">{privacy.refusal}</p>
          </section>

          <section class="pblock">
            <h3 class="pblock__title">{privacy.delegationTitle}</h3>
            <p class="pblock__lead">{privacy.delegationIntro}</p>
            <dl class="pdl pdl--wide">
              {
                privacy.delegation.map((row) => (
                  <div class="pdl__row">
                    <dt>{row.name}</dt>
                    <dd>{row.task}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="pblock__note">{privacy.delegationNote}</p>
          </section>

          <section class="pblock">
            <h3 class="pblock__title">{privacy.rightsTitle}</h3>
            <p class="pblock__lead">{privacy.rights}</p>
            <p class="pblock__contact">
              {privacy.officer}<br />{business.email} · {business.phone}
            </p>
          </section>
        </div>

        <label class="consent">
          <input type="checkbox" name="agreePrivacy" required />
          <span>{privacy.consentLabel}</span>
        </label>
      </fieldset>

      {/* ---------------- 5. 신청 내용 확인 ---------------- */}
      <fieldset class="step" data-step="4">
        <legend class="step__legend">
          <span class="eyebrow">STEP 05</span>
          <span class="step__title">신청 내용 확인</span>
        </legend>
        <p class="step__hint">
          아래 내용으로 접수됩니다. 수정이 필요하면 각 항목의 <strong>수정</strong>을 눌러
          해당 단계로 돌아가세요.
        </p>

        <div class="review" data-review>
          {
            reviewGroups.map((group) => (
              <section class="review__group" data-review-group={group.step}>
                <div class="review__head">
                  <h3 class="review__title">{group.title}</h3>
                  <button type="button" class="review__edit" data-goto-step={group.step}>
                    수정
                  </button>
                </div>
                <dl class="review__list">
                  {
                    group.fields.map(([key, label]) => (
                      <div class="review__row" data-review-row={key}>
                        <dt>{label}</dt>
                        <dd data-review-value={key}>—</dd>
                      </div>
                    ))
                  }
                </dl>
              </section>
            ))
          }
        </div>
      </fieldset>

      {/* Honeypot — real people never fill this. */}
      <p class="honeypot" aria-hidden="true">
        <label for="company_website">웹사이트</label>
        <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off" />
      </p>

      {/* Rendered explicitly when the last step opens — mounting it inside a
          hidden fieldset makes Turnstile misbehave. */}
      <div class="turnstile" data-turnstile hidden></div>

      <p class="form__error" role="alert" data-error hidden></p>

      <div class="nav">
        <button type="button" class="btn btn--ghost" data-prev hidden>이전</button>
        <button type="button" class="btn btn--next" data-next hidden>다음</button>
        <button type="submit" class="btn btn--submit" data-submit>예약 신청 제출</button>
      </div>
    </form>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');

  if (form) {
    // Captured once: TS loses the null-narrowing inside hoisted functions.
    const formEl: HTMLFormElement = form;
    const stepEls = Array.from(form.querySelectorAll<HTMLFieldSetElement>('[data-step]'));
    const progress = document.querySelector<HTMLElement>('[data-progress]');
    const progressItems = Array.from(document.querySelectorAll<HTMLElement>('[data-progress-item]'));
    const prevBtn = form.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = form.querySelector<HTMLButtonElement>('[data-next]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');
    const errorEl = form.querySelector<HTMLElement>('[data-error]');
    const durationEl = form.querySelector<HTMLElement>('[data-duration]');
    const startSel = form.querySelector<HTMLSelectElement>('#start');
    const endSel = form.querySelector<HTMLSelectElement>('#end');

    const MIN_HOURS = 3;

    // ?step=2 opens straight to a step. Handy for reviewing the later steps
    // without filling the earlier ones; harmless in production since the
    // submit handler re-validates every step regardless.
    const requested = Number(new URLSearchParams(location.search).get('step'));
    let step =
      Number.isInteger(requested) && requested >= 1 && requested <= stepEls.length
        ? requested - 1
        : 0;

    /* ---------- wizard ---------- */

    const render = () => {
      stepEls.forEach((el, i) => {
        el.hidden = i !== step;
      });
      progressItems.forEach((el, i) => {
        el.classList.toggle('is-active', i === step);
        el.classList.toggle('is-done', i < step);
      });
      if (prevBtn) prevBtn.hidden = step === 0;
      if (nextBtn) nextBtn.hidden = step === stepEls.length - 1;
      if (submitBtn) submitBtn.hidden = step !== stepEls.length - 1;
      if (errorEl) errorEl.hidden = true;
      if (step === stepEls.length - 1) {
        mountTurnstile();
        renderReview();
      }
      scrollToFormTop();
    };

    /**
     * Puts the top of the form just under the sticky header. scrollIntoView
     * with block:'nearest' did nothing when the step was already partly in
     * view, which left people mid-page on a new step.
     */
    function scrollToFormTop() {
      const anchor = document.querySelector<HTMLElement>('.form-section') ?? form;
      if (!anchor) return;
      const header = parseInt(
        getComputedStyle(document.documentElement).getPropertyValue('--header-height'),
        10
      );
      const offset = (Number.isFinite(header) ? header : 100) + 16;
      const y = anchor.getBoundingClientRect().top + window.scrollY - offset;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: Math.max(y, 0), behavior: reduced ? 'auto' : 'smooth' });
    }

    const showError = (message: string, field?: HTMLElement) => {
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }
      field?.focus();
    };

    /** Validates only the fields inside the current step. */
    const validateStep = () => {
      const current = stepEls[step];
      if (!current) return true;

      for (const el of Array.from(
        current.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          'input, select, textarea'
        )
      )) {
        // Referral is a checkbox group: at least one, but any number.
        if (el.type === 'checkbox' && el.name === 'referral') {
          const group = current.querySelectorAll<HTMLInputElement>('input[name="referral"]');
          if (!Array.from(group).some((c) => c.checked)) {
            showError('유입 경로를 하나 이상 선택해 주세요.', el);
            return false;
          }
          continue;
        }
        if (!el.checkValidity()) {
          showError(el.validationMessage || '입력값을 확인해 주세요.', el);
          return false;
        }
      }

      if (step === 0 && !checkDuration(true)) return false;
      return true;
    };

    /* ---------- duration: minimum 3 hours ---------- */

    const hourOf = (v: string) => Number(v.split(':')[0]);

    function checkDuration(report = false) {
      if (!startSel || !endSel) return true;
      const s = startSel.value;
      const e = endSel.value;
      if (!s || !e) {
        if (durationEl) durationEl.textContent = '';
        return true;
      }
      const hours = hourOf(e) - hourOf(s);
      if (hours <= 0) {
        if (durationEl) durationEl.textContent = '종료 시간이 시작 시간보다 늦어야 합니다.';
        if (report) showError('종료 시간이 시작 시간보다 늦어야 합니다.', endSel);
        return false;
      }
      if (hours < MIN_HOURS) {
        if (durationEl) durationEl.textContent = `${hours}시간 — 최소 ${MIN_HOURS}시간부터 신청할 수 있습니다.`;
        if (report) showError(`대관은 최소 ${MIN_HOURS}시간부터 신청할 수 있습니다.`, endSel);
        return false;
      }
      if (durationEl) durationEl.textContent = `총 ${hours}시간`;
      return true;
    }

    startSel?.addEventListener('change', () => checkDuration());
    endSel?.addEventListener('change', () => checkDuration());


    /* ---------- turnstile ---------- */

    const turnstileEl = form.querySelector<HTMLElement>('[data-turnstile]');
    const SITE_KEY = form.dataset.sitekey ?? '';
    let turnstileId: string | undefined;

    let turnstileTries = 0;

    /** Mounts once, the first time the last step is shown. */
    const mountTurnstile = () => {
      if (!turnstileEl || turnstileId !== undefined) return;
      const api = (window as any).turnstile;
      if (!api) {
        // api.js may still be loading. Retry for ~10s, then give up loudly
        // rather than polling forever.
        if (turnstileTries++ > 50) {
          showError('보안 확인을 불러오지 못했습니다. 광고 차단기를 끄거나 새로고침 후 다시 시도해 주세요.');
          return;
        }
        window.setTimeout(mountTurnstile, 200);
        return;
      }
      turnstileEl.hidden = false;
      turnstileId = api.render(turnstileEl, {
        sitekey: SITE_KEY,
        language: 'ko',
        'error-callback': () => showError('보안 확인을 불러오지 못했습니다. 새로고침 후 다시 시도해 주세요.'),
      });
    };

    const turnstileToken = () =>
      (form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value ?? '').trim();

    /* ---------- review ---------- */

    /** Fills the final screen from the live form values. */
    function renderReview() {
      const fd = new FormData(formEl);
      const val = (k: string) => String(fd.get(k) ?? '').trim();
      const all = (k: string) => fd.getAll(k).map(String);
      const checked = (k: string) =>
        formEl.querySelector<HTMLInputElement>(`[name="${k}"]`)?.checked ?? false;

      const start = val('start');
      const end = val('end');
      const hours = start && end ? Number(end.split(':')[0]) - Number(start.split(':')[0]) : 0;

      const values: Record<string, string> = {
        name: val('name'),
        org: val('org'),
        phone: val('phone'),
        email: val('email'),
        date: val('date'),
        __time: start && end ? `${start} ~ ${end} (${hours}시간)` : '',
        guests: val('guests') ? `${val('guests')}명` : '',
        purpose: val('purpose'),
        referral: all('referral').join(' · '),
        agreeRules: checked('agreeRules') ? '동의함' : '미동의',
        addons: all('addons').join(' · ') || '선택 없음',
        requests: val('requests'),
        agreePrivacy: checked('agreePrivacy') ? '동의함' : '미동의',
      };

      for (const [key, text] of Object.entries(values)) {
        const cell = formEl.querySelector<HTMLElement>(`[data-review-value="${key}"]`);
        if (!cell) continue;
        const empty = !text;
        cell.textContent = empty ? '입력 없음' : text;
        cell.classList.toggle('is-empty', empty);
      }
    }

    // "수정" jumps back to the owning step.
    formEl.querySelectorAll<HTMLButtonElement>('[data-goto-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = Number(btn.dataset.gotoStep) - 1;
        if (Number.isInteger(target) && target >= 0 && target < stepEls.length) {
          step = target;
          render();
        }
      });
    });

    /* ---------- nav ---------- */

    nextBtn?.addEventListener('click', () => {
      if (!validateStep()) return;
      step = Math.min(step + 1, stepEls.length - 1);
      render();
    });
    prevBtn?.addEventListener('click', () => {
      step = Math.max(step - 1, 0);
      render();
    });

    /** Collects the whole form, with checkbox groups as arrays. */
    const collect = () => {
      const fd = new FormData(form);
      const data: Record<string, unknown> = {};
      for (const key of new Set(Array.from(fd.keys()))) {
        const values = fd.getAll(key).map((v) => String(v));
        data[key] = key === 'referral' || key === 'addons' ? values : values[0];
      }
      data.agreeRules = form.querySelector<HTMLInputElement>('[name="agreeRules"]')?.checked ?? false;
      data.agreePrivacy = form.querySelector<HTMLInputElement>('[name="agreePrivacy"]')?.checked ?? false;
      return data;
    };

    const setBusy = (busy: boolean) => {
      if (!submitBtn) return;
      submitBtn.disabled = busy;
      submitBtn.textContent = busy ? '전송 중…' : '예약 신청 제출';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      // Validate every step, not just the visible one.
      for (let i = 0; i < stepEls.length; i++) {
        step = i;
        render();
        if (!validateStep()) return;
      }
      if (!turnstileToken()) {
        showError('보안 확인을 완료해 주세요.');
        return;
      }

      setBusy(true);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(collect()),
        });
        const result = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };

        if (!res.ok || !result.ok) {
          setBusy(false);
          // A spent Turnstile token can't be reused, so make the visitor solve
          // a fresh one rather than failing repeatedly.
          if (turnstileId !== undefined) (window as any).turnstile?.reset(turnstileId);
          showError(result.error || '접수에 실패했습니다. 잠시 후 다시 시도해 주세요.');
          return;
        }

        showSuccess();
      } catch {
        setBusy(false);
        if (turnstileId !== undefined) (window as any).turnstile?.reset(turnstileId);
        showError('네트워크 오류로 접수하지 못했습니다. 연결을 확인한 뒤 다시 시도해 주세요.');
      }
    });

    /** Replaces the form with a confirmation, so nobody submits twice. */
    function showSuccess() {
      const done = document.querySelector<HTMLElement>('[data-success]');
      if (!done) return;
      formEl.hidden = true;
      if (progress) progress.hidden = true;
      done.hidden = false;
      done.setAttribute('tabindex', '-1');
      done.focus();
      done.scrollIntoView({ block: 'start', behavior: 'smooth' });
    }

    if (progress) progress.hidden = false;
    render();
  }
</script>

