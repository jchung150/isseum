---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BulletList from '../components/BulletList.astro';
import {
  MIN_HOURS,
  OPEN_HOUR,
  CLOSE_HOUR,
  addOns,
  basicFields,
  basicStep,
  honeypotLabel,
  nav,
  noscript,
  optionsIntro,
  page,
  policyGroups,
  privacy,
  purposeField,
  referralField,
  referralSources,
  refundSection,
  requestsField,
  reviewGroups,
  reviewStep,
  rulesStep,
  steps,
  success,
  timeField,
} from '../data/booking';
import { business, turnstileSiteKey } from '../config/site';

// Item numbers are derived rather than stored — see data/booking.ts.
let itemCounter = 0;
const numberedGroups = policyGroups.map((group) => ({
  ...group,
  items: group.items.map((item) => ({ ...item, n: ++itemCounter })),
}));

// Half-hour slots, labelled 12-hour: 8:00am … 1:30pm … 10:00pm. The value stays
// 24-hour so it sorts and compares as plain text.
const times = Array.from({ length: (CLOSE_HOUR - OPEN_HOUR) * 2 + 1 }, (_, i) => {
  const minutes = OPEN_HOUR * 60 + i * 30;
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  const suffix = h < 12 ? 'am' : 'pm';
  const h12 = h % 12 === 0 ? 12 : h % 12;
  return {
    minutes,
    value: `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`,
    label: `${h12}:${String(m).padStart(2, '0')}${suffix}`,
  };
});

// A booking runs at least MIN_HOURS, so a start after CLOSE_HOUR - MIN_HOURS
// can never be completed and an end before OPEN_HOUR + MIN_HOURS can never be
// reached. Offering either would only lead to an error message later.
const startTimes = times.filter((t) => t.minutes <= (CLOSE_HOUR - MIN_HOURS) * 60);
const endTimes = times.filter((t) => t.minutes >= (OPEN_HOUR + MIN_HOURS) * 60);
---

<BaseLayout title={page.title} description={page.description} noindex>
  <PageHero eyebrow={page.eyebrow} title={page.title} lead={page.lead} wideLead />

  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    async
    defer></script>

  <section class="container form-section">
    {/* Turnstile requires JS, so the form as a whole does. Say so plainly and
        give a route that still works. */}
    <noscript>
      <div class="nojs">
        <p><strong>{noscript.title}</strong></p>
        <p>{noscript.body}</p>
        <p>
          <a href={`tel:${business.phone}`}>{business.phone}</a> ·
          <a href={`mailto:${business.email}`}>{business.email}</a>
        </p>
      </div>
    </noscript>
    {/* Progress. Hidden until JS turns the form into a wizard — without JS all
        four sections are simply visible in order, which still works. */}
    <ol class="progress" data-progress hidden>
      {
        steps.map((step, i) => (
          <li class="progress__item" data-progress-item={i}>
            <span class="mono-num progress__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="progress__label">{step.label}</span>
          </li>
        ))
      }
    </ol>

    {/* Shown in place of the form once the endpoint confirms receipt. */}
    <div class="done" data-success hidden>
      <p class="eyebrow">{success.eyebrow}</p>
      <h2 class="done__title">{success.title}</h2>
      <p class="done__body">{success.body}</p>
      <p class="done__body">
        {success.urgent.before}<a href={`tel:${business.phone}`}>{business.phone}</a
        >{success.urgent.after}
      </p>
      <div class="done__actions">
        <a href="/" class="btn btn--ghost">{success.home}</a>
      </div>
    </div>

    <form class="form" method="POST" action="/api/booking" data-form data-sitekey={turnstileSiteKey} data-min-hours={MIN_HOURS} novalidate>
      {/* ---------------- 1. 기본 정보 ---------------- */}
      <fieldset class="step" data-step="0">
        <legend class="step__legend">
          <span class="eyebrow">{basicStep.eyebrow}</span>
          <span class="step__title">{basicStep.title}</span>
        </legend>
        <p class="step__hint">{basicStep.hint}</p>

        <div class="grid">
          {
            basicFields.map((f) => (
              <p class="field">
                <label class="field__label" for={f.id}>
                  {f.label} {f.required && <span class="req">*</span>}
                </label>
                <input
                  class="input"
                  type={f.type}
                  id={f.id}
                  name={f.id}
                  required={f.required}
                  autocomplete={f.autocomplete}
                  inputmode={f.inputmode}
                  pattern={f.pattern}
                  min={f.min}
                  max={f.max}
                  placeholder={f.placeholder}
                />
              </p>
            ))
          }
        </div>

        <fieldset class="subfield">
          <legend class="field__label">
            {timeField.label} <span class="req">*</span>
            <span class="field__note">{timeField.note}</span>
          </legend>
          <div class="timerange">
            <label class="visually-hidden" for="start">{timeField.startLabel}</label>
            <select class="input" id="start" name="start" required>
              <option value="">{timeField.startEmpty}</option>
              {startTimes.map((t) => <option value={t.value}>{t.label}</option>)}
            </select>
            <span class="timerange__sep" aria-hidden="true">~</span>
            <label class="visually-hidden" for="end">{timeField.endLabel}</label>
            <select class="input" id="end" name="end" required>
              <option value="">{timeField.endEmpty}</option>
              {endTimes.map((t) => <option value={t.value} data-label={t.label}>{t.label}</option>)}
            </select>
          </div>
          <span class="field__note" data-duration aria-live="polite"></span>
        </fieldset>

        <p class="field">
          <label class="field__label" for="purpose">{purposeField.label} <span class="req">*</span></label>
          <textarea class="input input--area" id="purpose" name="purpose" required rows="3"
            placeholder={purposeField.placeholder}></textarea>
        </p>

        <fieldset class="subfield">
          <legend class="field__label">
            {referralField.label} <span class="req">*</span>
            <span class="field__note">{referralField.note}</span>
          </legend>
          <div class="chips">
            {
              referralSources.map((source) => (
                <label class="chip">
                  <input type="checkbox" name="referral" value={source} />
                  <span>{source}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
      </fieldset>

      {/* ---------------- 2. 이용 규정 ---------------- */}
      <fieldset class="step" data-step="1">
        <legend class="step__legend">
          <span class="eyebrow">{rulesStep.eyebrow}</span>
          <span class="step__title">{rulesStep.title}</span>
        </legend>
        <p class="step__hint">{rulesStep.hint}</p>

        <div class="policy" tabindex="0" role="region" aria-label={rulesStep.regionLabel}>
          {
            numberedGroups.map((group) => (
              <section class="policy__group">
                <h3 class="policy__group-title">{group.title}</h3>
                {group.items.map((item) => (
                  <article class="policy__item">
                    <h4 class="policy__item-title">
                      <span class="policy__n">{item.n}</span>
                      {item.title}
                    </h4>
                    {item.lines && <BulletList lines={item.lines} gap="10px" />}
                    {item.body && <p class="prose">{item.body}</p>}
                  </article>
                ))}
              </section>
            ))
          }

          <section class="policy__group">
            <h3 class="policy__group-title">{refundSection.title}</h3>
            <ul class="tiers">
              {
                refundSection.tiers.map((tier) => (
                  <li class="tier">
                    <span>{tier.when}</span>
                    <span class="tier__rate">{tier.rate}</span>
                  </li>
                ))
              }
            </ul>
            <div class="policy__item">
              <BulletList lines={refundSection.exceptions} gap="10px" />
            </div>
          </section>
        </div>

        <label class="consent">
          <input type="checkbox" name="agreeRules" required />
          <span>{rulesStep.consentLabel} <span class="req">*</span></span>
        </label>

      </fieldset>

      {/* ---------------- 3. 추가 옵션 ---------------- */}
      <fieldset class="step" data-step="2">
        <legend class="step__legend">
          <span class="eyebrow">{optionsIntro.eyebrow}</span>
          <span class="step__title">{optionsIntro.title}</span>
        </legend>
        <p class="step__hint">{optionsIntro.body}</p>
        <p class="notice-inline">{optionsIntro.note}</p>

        <div class="options">
          {
            addOns.map((addon) => (
              <label class="option">
                <input type="checkbox" name="addons" value={addon.title} />
                <span class="option__body">
                  <span class="option__head">
                    <span class="option__title">{addon.title}</span>
                    {addon.price && <span class="option__price">{addon.price}</span>}
                  </span>
                  {addon.notes && (
                    <span class="option__notes">
                      {addon.notes.map((note) => <span class="option__note">{note}</span>)}
                    </span>
                  )}
                </span>
              </label>
            ))
          }
        </div>

        <p class="field">
          <label class="field__label" for="requests">{requestsField.label}</label>
          <textarea class="input input--area" id="requests" name="requests" rows="3"
            placeholder={requestsField.placeholder}></textarea>
        </p>
      </fieldset>

      {/* ---------------- 4. 개인정보 동의 ---------------- */}
      <fieldset class="step" data-step="3">
        <legend class="step__legend">
          <span class="eyebrow">{privacy.eyebrow}</span>
          <span class="step__title">{privacy.title}</span>
        </legend>

        <div class="policy policy--privacy" tabindex="0" role="region" aria-label={privacy.regionLabel}>
          <section class="pblock">
            <p class="pblock__lead">{privacy.intro}</p>
            <dl class="pdl">
              {
                privacy.collection.map((row) => (
                  <div class="pdl__row">
                    <dt>{row.term}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="pblock__note">{privacy.refusal}</p>
          </section>

          <section class="pblock">
            <h3 class="pblock__title">{privacy.delegationTitle}</h3>
            <p class="pblock__lead">{privacy.delegationIntro}</p>
            <dl class="pdl pdl--wide">
              {
                privacy.delegation.map((row) => (
                  <div class="pdl__row">
                    <dt>{row.name}</dt>
                    <dd>{row.task}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="pblock__note">{privacy.delegationNote}</p>
          </section>

          <section class="pblock">
            <h3 class="pblock__title">{privacy.rightsTitle}</h3>
            <p class="pblock__lead">{privacy.rights}</p>
            <p class="pblock__contact">
              {privacy.officer}<br />{business.email} · {business.phone}
            </p>
          </section>
        </div>

        <label class="consent">
          <input type="checkbox" name="agreePrivacy" required />
          <span>{privacy.consentLabel}</span>
        </label>
      </fieldset>

      {/* ---------------- 5. 신청 내용 확인 ---------------- */}
      <fieldset class="step" data-step="4">
        <legend class="step__legend">
          <span class="eyebrow">{reviewStep.eyebrow}</span>
          <span class="step__title">{reviewStep.title}</span>
        </legend>
        <p class="step__hint">
          {reviewStep.hint.before}<strong>{reviewStep.hint.strong}</strong>{reviewStep.hint.after}
        </p>

        <div class="review" data-review>
          {
            reviewGroups.map((group) => (
              <section class="review__group" data-review-group={group.step}>
                <div class="review__head">
                  <h3 class="review__title">{group.title}</h3>
                  <button type="button" class="review__edit" data-goto-step={group.step}>
                    {reviewStep.editLabel}
                  </button>
                </div>
                <dl class="review__list">
                  {
                    group.fields.map(([key, label]) => (
                      <div class="review__row" data-review-row={key}>
                        <dt>{label}</dt>
                        <dd data-review-value={key}>{reviewStep.pending}</dd>
                      </div>
                    ))
                  }
                </dl>
              </section>
            ))
          }
        </div>
      </fieldset>

      {/* Honeypot — real people never fill this. */}
      <p class="honeypot" aria-hidden="true">
        <label for="company_website">{honeypotLabel}</label>
        <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off" />
      </p>

      {/* Rendered explicitly when the last step opens — mounting it inside a
          hidden fieldset makes Turnstile misbehave. */}
      <div class="turnstile" data-turnstile hidden></div>

      <p class="form__error" role="alert" data-error hidden></p>

      <div class="nav">
        <button type="button" class="btn btn--ghost" data-prev hidden>{nav.prev}</button>
        <button type="button" class="btn btn--next" data-next hidden>{nav.next}</button>
        <button type="submit" class="btn btn--submit" data-submit>{nav.submit}</button>
      </div>
    </form>
  </section>
</BaseLayout>

<script>
  // Same copy source as the markup above — the bundler tree-shakes the policy
  // text, which this half never touches.
  import { messages, nav, reviewValues } from '../data/booking';

  const form = document.querySelector<HTMLFormElement>('[data-form]');

  if (form) {
    // Captured once: TS loses the null-narrowing inside hoisted functions.
    const formEl: HTMLFormElement = form;
    const stepEls = Array.from(form.querySelectorAll<HTMLFieldSetElement>('[data-step]'));
    const progress = document.querySelector<HTMLElement>('[data-progress]');
    const progressItems = Array.from(document.querySelectorAll<HTMLElement>('[data-progress-item]'));
    const prevBtn = form.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = form.querySelector<HTMLButtonElement>('[data-next]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');
    const errorEl = form.querySelector<HTMLElement>('[data-error]');
    const durationEl = form.querySelector<HTMLElement>('[data-duration]');
    const startSel = form.querySelector<HTMLSelectElement>('#start');
    const endSel = form.querySelector<HTMLSelectElement>('#end');

    // Carried on the form so the constant lives only in data/booking.ts.
    const MIN_HOURS = Number(form.dataset.minHours) || 3;

    // ?step=2 opens straight to a step. Handy for reviewing the later steps
    // without filling the earlier ones; harmless in production since the
    // submit handler re-validates every step regardless.
    const requested = Number(new URLSearchParams(location.search).get('step'));
    let step =
      Number.isInteger(requested) && requested >= 1 && requested <= stepEls.length
        ? requested - 1
        : 0;

    /* ---------- wizard ---------- */

    const render = (scroll = false) => {
      stepEls.forEach((el, i) => {
        el.hidden = i !== step;
      });
      progressItems.forEach((el, i) => {
        el.classList.toggle('is-active', i === step);
        el.classList.toggle('is-done', i < step);
      });
      if (prevBtn) prevBtn.hidden = step === 0;
      if (nextBtn) nextBtn.hidden = step === stepEls.length - 1;
      if (submitBtn) submitBtn.hidden = step !== stepEls.length - 1;
      if (errorEl) errorEl.hidden = true;
      clearFieldErrors();
      if (step === stepEls.length - 1) {
        mountTurnstile();
        renderReview();
      }
      // Only a deliberate step change scrolls. The first paint must not (the
      // visitor has just arrived from a CTA), and neither must the submit
      // handler's sweep through every step to re-validate it.
      if (scroll) scrollToStepTop();
    };

    /**
     * Puts the top of the *current step* just under the sticky header, so the
     * progress strip and the card's own padding scroll out of the way. The
     * earlier version anchored on .form-section, which left the progress strip
     * filling the screen and the step heading pushed below the fold.
     *
     * Reading the anchor after a rAF matters: hiding one fieldset and showing
     * another changes the document height, and a target computed against the
     * old layout gets clamped to the old maximum scroll.
     */
    function scrollToStepTop() {
      const anchor = stepEls[step] ?? form;
      if (!anchor) return;
      const css = getComputedStyle(document.documentElement);
      // --header-h is measured at runtime by Header.astro; the static token is
      // the desktop-only fallback.
      const header = parseInt(
        css.getPropertyValue('--header-h') || css.getPropertyValue('--header-height'),
        10
      );
      const offset = (Number.isFinite(header) ? header : 100) + 16;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      requestAnimationFrame(() => {
        const y = anchor.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo({ top: Math.max(y, 0), behavior: reduced ? 'auto' : 'smooth' });
      });
    }

    /** Picks the message for a failed control. All copy is in data/booking.ts. */
    function messageFor(el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) {
      const v = el.validity;
      if (messages.consent[el.name]) return messages.consent[el.name];
      const label = messages.fieldLabels[el.name] ?? messages.fallbackLabel;
      const verb = el.tagName === 'SELECT' ? messages.verbSelect : messages.verbInput;
      if (v.valueMissing) return messages.missing(label, verb);
      if (v.typeMismatch && el.type === 'email') return messages.email;
      if (v.patternMismatch && el.name === 'phone') return messages.phone;
      if (el.name === 'date' && v.rangeUnderflow) return messages.pastDate;
      if (v.rangeOverflow) return messages.tooManyGuests((el as HTMLInputElement).max);
      if (v.rangeUnderflow) return messages.tooFewGuests;
      if (v.badInput || v.stepMismatch) return messages.numberOnly;
      return messages.invalid(label);
    }

    /** Wipes every inline field error. Called on each render and on edit. */
    function clearFieldErrors() {
      formEl.querySelectorAll('[data-field-error]').forEach((el) => el.remove());
      formEl.querySelectorAll('[aria-invalid]').forEach((el) => {
        el.removeAttribute('aria-invalid');
        el.classList.remove('is-invalid');
      });
    }

    /**
     * Puts the message directly under the offending control. A banner down by
     * the nav buttons meant the visitor read "이메일 형식이 아닙니다" a screen
     * away from the field it was about.
     */
    function showFieldError(field: HTMLElement, message: string) {
      // Several controls sit inside a wrapper — a consent <label>, the chip
      // list, the start/end pair. Anchoring to the control itself would drop
      // the message inside that box; anchor to the wrapper instead.
      const consent = field.closest('.consent');
      const group = field.closest('.chips, .timerange');
      const note = document.createElement('span');
      note.className = 'field__error';
      note.setAttribute('data-field-error', '');
      note.setAttribute('role', 'alert');
      note.textContent = message;

      if (consent) {
        consent.insertAdjacentElement('afterend', note);
      } else if (group) {
        group.parentElement?.appendChild(note);
      } else {
        field.insertAdjacentElement('afterend', note);
        field.classList.add('is-invalid');
      }
      field.setAttribute('aria-invalid', 'true');
      field.focus({ preventScroll: true });
      note.scrollIntoView({ block: 'nearest' });
    }

    const showError = (message: string, field?: HTMLElement) => {
      if (field) {
        showFieldError(field, message);
        return;
      }
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }
    };

    // Any edit clears the complaint about that control.
    form.addEventListener('input', (event) => {
      const el = event.target as HTMLElement;
      if (el?.getAttribute?.('aria-invalid')) {
        el.removeAttribute('aria-invalid');
        el.classList.remove('is-invalid');
        el.nextElementSibling?.matches('[data-field-error]') && el.nextElementSibling.remove();
      }
    });

    /** Validates only the fields inside the current step. */
    const validateStep = () => {
      const current = stepEls[step];
      if (!current) return true;

      for (const el of Array.from(
        current.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          'input, select, textarea'
        )
      )) {
        // Referral is a checkbox group: at least one, but any number.
        if (el.type === 'checkbox' && el.name === 'referral') {
          const group = current.querySelectorAll<HTMLInputElement>('input[name="referral"]');
          if (!Array.from(group).some((c) => c.checked)) {
            showError(messages.referralRequired, el);
            return false;
          }
          continue;
        }
        if (!el.checkValidity()) {
          showError(messageFor(el), el);
          return false;
        }
      }

      if (step === 0 && !checkDuration(true)) return false;
      return true;
    };

    /* ---------- duration: minimum 3 hours ---------- */

    /** Minutes from midnight — half-hour slots make plain hour arithmetic wrong. */
    const minOf = (v: string) => {
      const [h, m] = v.split(':').map(Number);
      return h * 60 + (m || 0);
    };
    const hoursBetween = (a: string, b: string) => (minOf(b) - minOf(a)) / 60;
    /** 3 → "3", 3.5 → "3.5". */
    const fmtHours = (h: number) => (Number.isInteger(h) ? String(h) : h.toFixed(1));

    function checkDuration(report = false) {
      if (!startSel || !endSel) return true;
      const s = startSel.value;
      const e = endSel.value;
      if (!s || !e) {
        if (durationEl) durationEl.textContent = '';
        return true;
      }
      const hours = hoursBetween(s, e);
      if (hours <= 0) {
        if (durationEl) durationEl.textContent = messages.endBeforeStart;
        if (report) endSel.focus({ preventScroll: true });
        return false;
      }
      if (hours < MIN_HOURS) {
        if (durationEl) durationEl.textContent = messages.tooShort(fmtHours(hours), MIN_HOURS);
        if (report) endSel.focus({ preventScroll: true });
        return false;
      }
      if (durationEl) durationEl.textContent = messages.totalHours(fmtHours(hours));
      return true;
    }

    /**
     * Hides every end time that would make the booking shorter than the
     * minimum — pick 13:00 and the end list starts at 16:00. Cheaper for the
     * visitor than letting them choose 14:00 and then rejecting it.
     */
    function syncEndOptions() {
      if (!startSel || !endSel) return;
      const start = startSel.value;
      const earliest = start ? minOf(start) + MIN_HOURS * 60 : 0;
      let clearedSelection = false;
      for (const opt of Array.from(endSel.options)) {
        if (!opt.value) continue;
        const base = opt.dataset.label ?? opt.textContent ?? '';
        const tooEarly = minOf(opt.value) < earliest;
        opt.hidden = tooEarly;
        // Safari ignores `hidden` on <option>; `disabled` stops it either way.
        opt.disabled = tooEarly;
        // Show what each end time actually buys: 9:00pm (3시간).
        opt.textContent = start && !tooEarly
          ? `${base} ${messages.optionHours(fmtHours(hoursBetween(start, opt.value)))}`
          : base;
        if (tooEarly && opt.selected) clearedSelection = true;
      }
      if (clearedSelection) endSel.value = '';
    }

    /**
     * The page is prerendered, so a build-time `min` would freeze at the deploy
     * date. Set it on load instead, in the visitor's own local date.
     */
    const dateInput = form.querySelector<HTMLInputElement>('#date');
    if (dateInput) {
      const now = new Date();
      const pad = (n: number) => String(n).padStart(2, '0');
      dateInput.min = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
    }

    startSel?.addEventListener('change', () => {
      syncEndOptions();
      checkDuration();
    });
    endSel?.addEventListener('change', () => checkDuration());
    syncEndOptions();


    /* ---------- turnstile ---------- */

    const turnstileEl = form.querySelector<HTMLElement>('[data-turnstile]');
    const SITE_KEY = form.dataset.sitekey ?? '';
    let turnstileId: string | undefined;

    let turnstileTries = 0;

    /** Mounts once, the first time the last step is shown. */
    const mountTurnstile = () => {
      if (!turnstileEl || turnstileId !== undefined) return;
      const api = (window as any).turnstile;
      if (!api) {
        // api.js may still be loading. Retry for ~10s, then give up loudly
        // rather than polling forever.
        if (turnstileTries++ > 50) {
          showError(messages.turnstileBlocked);
          return;
        }
        window.setTimeout(mountTurnstile, 200);
        return;
      }
      turnstileEl.hidden = false;
      turnstileId = api.render(turnstileEl, {
        sitekey: SITE_KEY,
        language: 'ko',
        'error-callback': () => showError(messages.turnstileFailed),
      });
    };

    const turnstileToken = () =>
      (form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value ?? '').trim();

    /* ---------- review ---------- */

    /** Fills the final screen from the live form values. */
    function renderReview() {
      const fd = new FormData(formEl);
      const val = (k: string) => String(fd.get(k) ?? '').trim();
      const all = (k: string) => fd.getAll(k).map(String);
      const checked = (k: string) =>
        formEl.querySelector<HTMLInputElement>(`[name="${k}"]`)?.checked ?? false;

      const start = val('start');
      const end = val('end');
      const hours = start && end ? hoursBetween(start, end) : 0;

      const values: Record<string, string> = {
        name: val('name'),
        org: val('org'),
        phone: val('phone'),
        email: val('email'),
        date: val('date'),
        __time: start && end ? reviewValues.time(start, end, fmtHours(hours)) : '',
        guests: val('guests') ? reviewValues.guests(val('guests')) : '',
        purpose: val('purpose'),
        referral: all('referral').join(reviewValues.separator),
        agreeRules: checked('agreeRules') ? reviewValues.agreed : reviewValues.declined,
        addons: all('addons').join(reviewValues.separator) || reviewValues.none,
        requests: val('requests'),
        agreePrivacy: checked('agreePrivacy') ? reviewValues.agreed : reviewValues.declined,
      };

      for (const [key, text] of Object.entries(values)) {
        const cell = formEl.querySelector<HTMLElement>(`[data-review-value="${key}"]`);
        if (!cell) continue;
        const empty = !text;
        cell.textContent = empty ? reviewValues.empty : text;
        cell.classList.toggle('is-empty', empty);
      }
    }

    // "수정" jumps back to the owning step.
    formEl.querySelectorAll<HTMLButtonElement>('[data-goto-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = Number(btn.dataset.gotoStep) - 1;
        if (Number.isInteger(target) && target >= 0 && target < stepEls.length) {
          step = target;
          render(true);
        }
      });
    });

    /* ---------- nav ---------- */

    nextBtn?.addEventListener('click', () => {
      if (!validateStep()) return;
      step = Math.min(step + 1, stepEls.length - 1);
      render(true);
    });
    prevBtn?.addEventListener('click', () => {
      step = Math.max(step - 1, 0);
      render(true);
    });

    /** Collects the whole form, with checkbox groups as arrays. */
    const collect = () => {
      const fd = new FormData(form);
      const data: Record<string, unknown> = {};
      for (const key of new Set(Array.from(fd.keys()))) {
        const values = fd.getAll(key).map((v) => String(v));
        data[key] = key === 'referral' || key === 'addons' ? values : values[0];
      }
      data.agreeRules = form.querySelector<HTMLInputElement>('[name="agreeRules"]')?.checked ?? false;
      data.agreePrivacy = form.querySelector<HTMLInputElement>('[name="agreePrivacy"]')?.checked ?? false;
      return data;
    };

    const setBusy = (busy: boolean) => {
      if (!submitBtn) return;
      submitBtn.disabled = busy;
      submitBtn.textContent = busy ? nav.submitting : nav.submit;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      // Validate every step, not just the visible one.
      for (let i = 0; i < stepEls.length; i++) {
        step = i;
        render();
        if (!validateStep()) return;
      }
      if (!turnstileToken()) {
        showError(messages.turnstileRequired);
        return;
      }

      setBusy(true);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(collect()),
        });
        const result = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };

        if (!res.ok || !result.ok) {
          setBusy(false);
          // A spent Turnstile token can't be reused, so make the visitor solve
          // a fresh one rather than failing repeatedly.
          if (turnstileId !== undefined) (window as any).turnstile?.reset(turnstileId);
          showError(result.error || messages.submitFailed);
          return;
        }

        showSuccess();
      } catch {
        setBusy(false);
        if (turnstileId !== undefined) (window as any).turnstile?.reset(turnstileId);
        showError(messages.networkFailed);
      }
    });

    /** Replaces the form with a confirmation, so nobody submits twice. */
    function showSuccess() {
      const done = document.querySelector<HTMLElement>('[data-success]');
      if (!done) return;
      formEl.hidden = true;
      if (progress) progress.hidden = true;
      // The masthead and the step list belong to a form that no longer exists.
      // Clearing them leaves the confirmation alone on the screen.
      const hero = document.querySelector<HTMLElement>('[data-page-hero]');
      if (hero) hero.hidden = true;
      done.hidden = false;
      done.setAttribute('tabindex', '-1');
      done.focus({ preventScroll: true });

      // Removing a tall form shortens the page, and the browser clamps the old
      // scroll position to the new maximum — which left the visitor at the
      // bottom, below the confirmation. Put the panel under the header
      // instead. Instant, not smooth: this is a correction, not a journey.
      requestAnimationFrame(() => {
        const css = getComputedStyle(document.documentElement);
        const header =
          parseInt(css.getPropertyValue('--header-h') || css.getPropertyValue('--header-height'), 10) || 100;
        const box = done.getBoundingClientRect();
        window.scrollTo({ top: Math.max(0, box.top + window.scrollY - header - 24), behavior: 'auto' });
      });
    }

    if (progress) progress.hidden = false;
    render();
  }
</script>

<style is:global>
  /* Scoped styles can't reach <body>. Only this page loads it. */
  body {
    background: var(--surface);
  }

  /* Validation messages are created in JS, so they never carry Astro's scope
     attribute and a scoped rule would not match them. */
  .field__error {
    font-size: var(--text-fine);
    font-weight: 500;
    color: var(--error);
    letter-spacing: var(--tracking-meta);
  }

  /* The consent checkbox sits in its own bordered block, so the message needs
     a gap to read as belonging to it rather than to whatever follows. */
  .consent + .field__error {
    display: block;
    margin-top: var(--space-3);
  }
</style>

<style>
