---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DarkCta from '../components/DarkCta.astro';
import { Image } from 'astro:assets';
import { page, sections } from '../data/guide';
import { closingCta } from '../data/home';
---

<BaseLayout title={page.title} description={page.description}>
  <PageHero eyebrow={page.eyebrow} title={page.heading} lead={page.lead} />

  {/* 목차. 한 페이지에 네 섹션이 길게 이어지므로 앵커로 건너뛸 수 있게 한다. */}
  <nav class="container toc" aria-label={page.tocLabel}>
    <ol class="toc__list">
      {
        sections.map((section, i) => (
          <li class="toc__item">
            <a class="toc__link" href={`#${section.slug}`}>
              <span class="mono-num toc__num">{String(i + 1).padStart(2, '0')}</span>
              <span>{section.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  {
    sections.map((section, i) => (
      <section id={section.slug} class="container section anchor guide">
        <header class="guide__head">
          <span class="mono-num">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="display guide__title">{section.title}</h2>
        </header>

        <div class="guide__body">
          {section.blocks.map((block) => {
            if (block.kind === 'heading') return <h3 class="guide__sub">{block.text}</h3>;

            if (block.kind === 'text') return <p class="prose guide__text">{block.body}</p>;

            if (block.kind === 'bullets' || block.kind === 'steps') {
              const Tag = block.kind === 'steps' ? 'ol' : 'ul';
              return (
                <Tag class:list={['lines', block.kind === 'steps' && 'lines--steps']}>
                  {block.items.map((line) => (
                    <li class="line">
                      <p class="prose">
                        {line.label && <strong>{line.label}</strong>}
                        {line.text}
                      </p>
                      {line.details && (
                        <ul class="line__details">
                          {line.details.map((d) => (
                            <li>{d}</li>
                          ))}
                        </ul>
                      )}
                      {line.shots?.map((shot) => (
                        <figure class="shot shot--inline">
                          {shot.src ? (
                            <Image
                              class="shot__img"
                              src={shot.src}
                              alt={shot.alt}
                              widths={[400, 700]}
                              sizes="(min-width: 900px) 520px, 100vw"
                              loading="lazy"
                            />
                          ) : (
                            <div
                              class="ph shot__ph"
                              role="img"
                              aria-label={page.pendingPrefix + shot.alt}
                            />
                          )}
                          <figcaption class="shot__cap">
                            {!shot.src && page.pendingPrefix}
                            {shot.caption ?? shot.alt}
                          </figcaption>
                        </figure>
                      ))}
                    </li>
                  ))}
                </Tag>
              );
            }

            if (block.kind === 'note') {
              return (
                <aside class="note">
                  {block.title && <p class="note__title">{block.title}</p>}
                  {block.body.map((p) => (
                    <p class="note__body">{p}</p>
                  ))}
                </aside>
              );
            }

            if (block.kind === 'link') {
              return (
                <div class="refbox">
                  <a class="refbox__link" href={block.href} target="_blank" rel="noopener">
                    {block.label}
                  </a>
                  <dl class="refbox__list">
                    {block.lines.map((line) => (
                      <div class="refbox__row">
                        <dt>{line.label?.replace(/\s*—\s*$/, '')}</dt>
                        <dd>{line.text}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              );
            }

            /* figure — src가 없으면 아직 받지 못한 사진이다. 자리를 비우지 않고
               플레이스홀더로 남겨 무엇이 빠졌는지 페이지에서 바로 보이게 한다. */
            return (
              <figure class="shot">
                {block.src ? (
                  <Image
                    class="shot__img"
                    src={block.src}
                    alt={block.alt}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 900px) 760px, 100vw"
                    loading="lazy"
                  />
                ) : (
                  <div class="ph shot__ph" role="img" aria-label={page.pendingPrefix + block.alt} />
                )}
                <figcaption class="shot__cap">
                  {!block.src && page.pendingPrefix}
                  {block.caption ?? block.alt}
                </figcaption>
              </figure>
            );
          })}
        </div>
      </section>
    ))
  }

  <section class="container section">
    <DarkCta headline={closingCta.headline} sub={closingCta.sub} />
  </section>
</BaseLayout>

<style>
  /* ---------- 목차 ---------- */
  .toc {
    margin-top: var(--space-section-sm);
  }

  .toc__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--border);
    border: var(--border-hairline);
  }

  .toc__item {
    background: var(--bg);
  }

  .toc__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-list-name);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    color: var(--ink);
    transition: background var(--transition-fast);
  }

  .toc__link:hover {
    background: var(--surface);
  }

  .toc__num {
    flex: none;
  }

  /* ---------- 섹션 ---------- */
  .guide__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-emphasis);
  }

  .guide__title {
    font-size: var(--display-group);
  }

  .guide__body {
    margin-top: var(--space-8);
    max-width: var(--measure-lead);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .guide__sub {
    margin-top: var(--space-6);
    font-size: var(--text-item-title);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    color: var(--ink);
  }

  .guide__sub:first-child {
    margin-top: 0;
  }

  /* ---------- 줄 목록 ---------- */
  .lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    counter-reset: line;
  }

  .line {
    position: relative;
    padding-left: var(--space-6);
  }

  .lines:not(.lines--steps) .line::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 11px;
    width: var(--space-1);
    height: var(--space-1);
    background: var(--text-tertiary);
    border-radius: var(--radius-full);
  }

  .lines--steps .line {
    counter-increment: line;
  }

  .lines--steps .line::before {
    content: counter(line);
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: var(--mono-num);
    letter-spacing: var(--tracking-mono);
    color: var(--text-tertiary);
    line-height: var(--leading-body);
  }

  .line__details {
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-ui);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-ui);
  }

  .line__details li::before {
    content: '·';
    margin-right: var(--space-2);
    color: var(--text-tertiary);
  }

  /* ---------- 강조 상자 ---------- */
  .note {
    padding: var(--space-5);
    border: var(--border-hairline);
    background: var(--surface);
  }

  .note__title {
    font-size: var(--text-ui);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    color: var(--ink);
    margin-bottom: var(--space-2);
  }

  .note__body {
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--text-body);
    letter-spacing: var(--tracking-body);
  }

  .note__body + .note__body {
    margin-top: var(--space-2);
  }

  /* ---------- 외부 참조 (인근 주차장) ---------- */
  .refbox {
    padding: var(--space-5);
    border: var(--border-hairline);
  }

  .refbox__link {
    font-size: var(--text-list-name);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .refbox__link:hover {
    color: var(--link-hover);
    border-color: var(--link-hover);
  }

  .refbox__list {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .refbox__row {
    display: grid;
    grid-template-columns: 5.5em 1fr;
    gap: var(--space-3);
    font-size: var(--text-ui);
    letter-spacing: var(--tracking-ui);
  }

  .refbox__row dt {
    color: var(--text-secondary);
  }

  .refbox__row dd {
    color: var(--text-body);
    line-height: var(--leading-compact);
  }

  /* ---------- 사진 ---------- */
  .shot {
    margin-top: var(--space-2);
  }

  .shot :global(.shot__img) {
    width: 100%;
    height: auto;
    border: var(--border-hairline);
  }

  /* 아직 받지 못한 사진 자리. 실제 사진과 같은 3:2로 두면 빈 해칭이 페이지를
     뒤덮으므로, 자리를 표시할 만큼만 낮게 잡는다. */
  .shot__ph {
    aspect-ratio: 16 / 4;
    border: var(--border-hairline);
  }

  /* 조작 단계에 딸린 사진은 본문보다 한 단 좁게 — 글과 사진의 1:1 관계가 보이게. */
  .shot--inline {
    margin-top: var(--space-3);
    max-width: 520px;
  }

  .shot__cap {
    margin-top: var(--space-3);
    font-size: var(--text-meta);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-meta);
  }

  /* ---------- Breakpoints ---------- */
  @media (min-width: 640px) {
    .toc__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
