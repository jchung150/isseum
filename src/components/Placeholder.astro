---
/**
 * Stands in for unshot photography, and stays as the missing-image fallback
 * once real assets land. design/COMPONENTS.md §4.
 */
interface Props {
  label: string;
  ratio?: string;
  align?: 'center' | 'end';
  size?: 'lg' | 'md';
  border?: 'all' | 'sides';
  class?: string;
}

const {
  label,
  ratio = 'var(--ratio-media)',
  align = 'center',
  size = 'md',
  border = 'all',
  class: className,
} = Astro.props;
---

<div
  class:list={['ph', 'slot', `slot--${align}`, `slot--border-${border}`, className]}
  style={`aspect-ratio: ${ratio};`}
  role="img"
  aria-label={label}
>
  <span class:list={['slot__label', `slot__label--${size}`]} aria-hidden="true">{label}</span>
</div>

<style>
  .slot {
    display: flex;
    justify-content: center;
    padding: 18px;
  }

  .slot--center {
    align-items: center;
  }

  .slot--end {
    align-items: flex-end;
  }

  .slot--border-all {
    border: var(--border-hairline);
  }

  /* Hero butts against the header, so it takes no top border. */
  .slot--border-sides {
    border-left: var(--border-hairline);
    border-right: var(--border-hairline);
    border-bottom: var(--border-hairline);
  }

  .slot__label {
    font-family: var(--font-mono);
    color: var(--text-secondary);
    background: var(--bg);
    border: var(--border-hairline);
    text-align: center;
  }

  .slot__label--lg {
    font-size: var(--mono-slot-lg);
    letter-spacing: 0.14em;
    padding: 9px var(--space-4);
  }

  .slot__label--md {
    font-size: var(--mono-slot);
    letter-spacing: 0.12em;
    padding: 7px var(--space-3);
  }
</style>
