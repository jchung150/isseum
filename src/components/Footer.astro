---
/**
 * Footer and contact in one cobalt band: the closing line, the four inquiry
 * channels, business details and the link to the rental terms. `#contact` is the
 * target of every inquiry CTA on the site, so every page renders this.
 */
import Emblem from './Emblem.astro';
import { business, kakaoChannelUrl, naverTalkUrl } from '../config/site';
import { content } from '../data';
import { localePath, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { footer, channels } = content[lang].common;
const { business: biz, cards } = footer;

const chats = [
  { ...cards.naverTalk, href: naverTalkUrl },
  ...(kakaoChannelUrl ? [{ ...cards.kakao, href: kakaoChannelUrl }] : []),
];
const rulesHref = localePath(lang, '/rules');
---

<footer class="contact on-cobalt" id="contact" aria-labelledby="contact-title">
  <Emblem tone="paper" class="contact__emb" />
  <div class="wrap">
    <h2 id="contact-title" class="contact__title">
      <span class="hand">{footer.heading.hand}</span>{footer.heading.rest}
    </h2>

    <ul class="channels">
      {
        chats.map((chat) => (
          <li>
            <a class="ch" href={chat.href} target="_blank" rel="noopener">
              <span class="ch__label">{chat.label}</span>
              <span class="ch__value">{chat.value}</span>
              <span class="visually-hidden">{channels.newWindow}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a class="ch" href={`tel:${business.phone}`}>
          <span class="ch__label">{cards.phone}</span>
          <span class="ch__value">{business.phone}</span>
        </a>
      </li>
      <li>
        <a class="ch" href={`mailto:${business.email}`}>
          <span class="ch__label">{cards.email}</span>
          <span class="ch__value">{business.email}</span>
        </a>
      </li>
    </ul>

    <div class="biz">
      <dl>
        <dt>{biz.company.term}</dt><dd>{biz.company.value}</dd>
        <dt>{biz.representative.term}</dt><dd>{biz.representative.value}</dd>
        <dt>{biz.address.term}</dt><dd>{biz.address.value}</dd>
        <dt>{biz.registration.term}</dt><dd>{business.registrationNumber}</dd>
      </dl>
      <p class="links">
        <a href={rulesHref}>{footer.rulesLink}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-band);
    background: var(--cobalt);
    color: var(--paper);
  }

  /* Hangs from the top edge beside the heading, short enough to clear the cards. */
  .contact :global(.contact__emb) {
    position: absolute;
    right: max(var(--side), 6vw);
    top: -1px;
    --w: clamp(56px, 6vw, 84px);
  }

  @media (max-width: 899px) {
    .contact :global(.contact__emb) {
      display: none;
    }
  }

  .contact__title {
    position: relative;
    margin-bottom: var(--space-head);
    font-size: var(--type-section);
    font-weight: 900;
    letter-spacing: var(--track-section);
    line-height: var(--lead-section);
    color: var(--paper);
    text-wrap: balance;
  }

  :lang(en) .contact__title {
    letter-spacing: var(--track-section-en);
  }

  .contact__title .hand {
    margin-bottom: 0.3em;
  }

  .channels {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .channels {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .channels {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .ch {
    display: grid;
    gap: 6px;
    height: 100%;
    padding: var(--space-6);
    border: var(--rule) solid var(--lime);
    border-radius: var(--radius-card);
    background: var(--cobalt);
    color: var(--paper);
  }

  .ch:hover {
    background: var(--paper);
    color: var(--cobalt);
  }

  .ch__label {
    font: 700 var(--type-label) var(--font-latin);
    letter-spacing: var(--track-label-wide);
    color: var(--lime);
  }

  .ch:hover .ch__label {
    color: var(--cobalt);
  }

  .ch__value {
    font-size: var(--type-channel);
    font-weight: 700;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  .biz {
    position: relative;
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 28px;
    border-top: var(--rule) solid var(--rule-on-cobalt);
  }

  .biz dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-1) var(--space-4);
    font-size: var(--type-meta);
  }

  .biz dt {
    color: var(--lime);
  }

  .links {
    display: flex;
    gap: var(--space-5);
    margin-top: var(--space-4);
    font-size: var(--type-meta);
    font-weight: 700;
  }

  .links a {
    color: var(--paper);
  }

  .links a:hover {
    color: var(--lime);
  }
</style>
