---
import { Image } from 'astro:assets';
import logo from '../assets/isseum-logo.png';
import mapImage from '../assets/naver_map.png';
import { business, footerLinks, naverMapUrl, socialLinks, site } from '../config/site';

const info = [
  { term: '상호명', value: business.companyName },
  { term: '대표자명', value: business.representative },
  { term: '주소', value: business.address },
  { term: '연락처', value: business.phone, href: `tel:${business.phone}` },
  { term: '이메일', value: business.email, href: `mailto:${business.email}` },
  { term: '사업자등록번호', value: business.registrationNumber },
];
---

<footer>
  <div class="grid container">
    <div>
      <a href="/" class="logo" aria-label={`${site.name} ${site.nameLatin} 홈`}>
        <Image src={logo} alt={`${site.name} ${site.nameLatin}`} height={112} densities={[1, 2]} />
      </a>
      <dl class="info">
        {
          info.map((row) => (
            <>
              <dt>{row.term}</dt>
              <dd>{row.href ? <a href={row.href}>{row.value}</a> : row.value}</dd>
            </>
          ))
        }
      </dl>
    </div>

    <div>
      <p class="eyebrow eyebrow--label label">LOCATION</p>
      {/* A static image rather than an embed: the footer is on every page, and
          a third-party map script would put external JS on all of them — plus
          make the map provider a data processor. Tapping opens the real map. */}
      <a class="map" href={naverMapUrl} target="_blank" rel="noopener">
        <Image
          class="map__img"
          src={mapImage}
          alt={`이씀 위치 지도 — ${business.address} (네이버 지도에서 열기)`}
          widths={[400, 640, 900]}
          sizes="(min-width: 900px) 32vw, 92vw"
          loading="lazy"
        />
      </a>
    </div>

    <div class="col-links">
      <div>
        <p class="eyebrow eyebrow--label label">주요 안내</p>
        <nav class="links" aria-label="주요 안내">
          {
            footerLinks.map((link) => (
              <a
                href={link.href}
                class="links__row"
                {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {link.label}
                <span class="links__arrow" aria-hidden="true">{link.external ? '↗' : '→'}</span>
              </a>
            ))
          }
        </nav>
      </div>

      <div>
        <p class="eyebrow eyebrow--label label">공식 채널</p>
        <div class="social">
          {
            socialLinks.map((link) => (
              <a href={link.href} class="social__chip" target="_blank" rel="noopener">
                <span class:list={['social__glyph', `social__glyph--${link.glyph}`]} aria-hidden="true" />
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="bottom">
    <div class="bottom__inner container">
      <span>© 2026 {site.nameLatin}. All rights reserved.</span>
      <span class="bottom__place">SEOUL · KOREA</span>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--space-section);
    border-top: var(--border-hairline);
    background: var(--surface);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--gap-lg);
    padding-top: var(--space-section-sm);
    padding-bottom: clamp(28px, 3vw, 44px);
  }

  .logo :global(img) {
    height: var(--logo-height-footer);
    width: auto;
  }

  .label {
    margin-bottom: var(--space-4);
  }

  .map {
    display: block;
    position: relative;
    border: var(--border-hairline);
    transition: border-color var(--transition-fast);
  }

  .map:hover {
    border-color: var(--ink);
  }

  .map :global(.map__img) {
    width: 100%;
    aspect-ratio: var(--ratio-map);
    object-fit: cover;
    display: block;
  }


  .info {
    margin-top: 26px;
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 11px 0;
    font-size: var(--text-ui);
    letter-spacing: var(--tracking-ui);
  }

  .info dt {
    color: var(--text-secondary);
  }

  .info dd {
    color: var(--text-strong);
  }


  .col-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .links {
    display: flex;
    flex-direction: column;
    border-top: var(--border-hairline);
  }

  .links__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 0;
    border-bottom: var(--border-hairline);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-body);
  }

  .links__arrow {
    color: var(--text-tertiary);
    font-size: var(--text-xs);
  }

  .social {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .social__chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: var(--border-hairline);
    background: var(--bg);
    padding: 11px var(--space-4);
    border-radius: var(--radius);
    font-size: var(--text-ui-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-ui);
    transition: border-color var(--transition-fast);
  }

  .social__chip:hover {
    border-color: var(--ink);
  }

  /* Icons are pure CSS shapes — no icon font, no SVG. design/COMPONENTS.md §10. */
  .social__glyph {
    width: 15px;
    height: 15px;
    border: var(--border-active);
  }

  .social__glyph--square {
    border-radius: var(--radius-sm);
  }

  .social__glyph--circle {
    border-radius: var(--radius-full);
  }

  .bottom {
    border-top: var(--border-hairline);
  }

  .bottom__inner {
    padding-block: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-meta);
  }

  .bottom__place {
    letter-spacing: var(--tracking-step);
  }
</style>
