---
import { Image } from 'astro:assets';
import logo from '../assets/isseum-logo.png';
import mapImage from '../assets/naver_map.png';
import { business, inquiryChannels, naverMapUrl, site } from '../config/site';
import { inquiryCta } from '../data/cta';
import { footer } from '../data/footer';
import { header } from '../data/header';

const info = [
  { term: footer.info.companyName, value: business.companyName },
  { term: footer.info.representative, value: business.representative },
  { term: footer.info.address, value: business.address },
  { term: footer.info.phone, value: business.phone, href: `tel:${business.phone}` },
  { term: footer.info.email, value: business.email, href: `mailto:${business.email}` },
  ...inquiryChannels.map((channel) => ({
    term: footer.info.chat,
    value: channel.name,
    href: channel.href,
    external: true,
  })),
  { term: footer.info.registrationNumber, value: business.registrationNumber },
];
---

<footer>
  <div class="grid container">
    <div>
      <a href="/" class="logo" aria-label={header.homeLabel(site.name, site.nameLatin)}>
        <Image src={logo} alt={`${site.name} ${site.nameLatin}`} height={112} densities={[1, 2]} />
      </a>
      <dl class="info">
        {
          info.map((row) => (
            <>
              <dt>{row.term}</dt>
              <dd>
                {row.href ? (
                  'external' in row ? (
                    <a href={row.href} target="_blank" rel="noopener">
                      {row.value}<span class="visually-hidden">{inquiryCta.channelNewWindow}</span>
                    </a>
                  ) : (
                    <a href={row.href}>{row.value}</a>
                  )
                ) : (
                  row.value
                )}
              </dd>
            </>
          ))
        }
      </dl>
    </div>

    <div class="location">
      <p class="eyebrow eyebrow--label label">{footer.locationEyebrow}</p>
      {/* A static image rather than an embed: the footer is on every page, and
          a third-party map script would put external JS on all of them — plus
          make the map provider a data processor. Tapping opens the real map. */}
      <a class="map" href={naverMapUrl} target="_blank" rel="noopener">
        <Image
          class="map__img"
          src={mapImage}
          alt={footer.mapAlt(business.address)}
          widths={[400, 640, 900]}
          sizes="360px"
          loading="lazy"
        />
      </a>
    </div>
  </div>

  <div class="bottom">
    <div class="bottom__inner container">
      <span>{footer.copyright(2026, site.nameLatin)}</span>
      <span class="bottom__place">{footer.place}</span>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--space-section);
    border-top: var(--border-hairline);
    background: var(--surface);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-lg);
    padding-top: var(--space-section-sm);
    padding-bottom: clamp(28px, 3vw, 44px);
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1fr var(--footer-map-width);
    }
  }

  .location {
    max-width: var(--footer-map-width);
  }

  .logo :global(img) {
    height: var(--logo-height-footer);
    width: auto;
  }

  .label {
    margin-bottom: var(--space-4);
  }

  .map {
    display: block;
    position: relative;
    border: var(--border-hairline);
    transition: border-color var(--transition-fast);
  }

  .map:hover {
    border-color: var(--ink);
  }

  .map :global(.map__img) {
    width: 100%;
    aspect-ratio: var(--ratio-map);
    object-fit: cover;
    display: block;
  }


  .info {
    margin-top: 26px;
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 11px 0;
    font-size: var(--text-ui);
    letter-spacing: var(--tracking-ui);
  }

  .info dt {
    color: var(--text-secondary);
  }

  .info dd {
    color: var(--text-strong);
  }


  .bottom {
    border-top: var(--border-hairline);
  }

  .bottom__inner {
    padding-block: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-meta);
  }

  .bottom__place {
    letter-spacing: var(--tracking-step);
  }
</style>
