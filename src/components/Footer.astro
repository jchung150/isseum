---
import { Image } from 'astro:assets';
import logo from '../assets/isseum-logo.png';
import { business, inquiryChannels, site } from '../config/site';
import { inquiryCta } from '../data/cta';
import { footer } from '../data/footer';
import { header } from '../data/header';

type Link = { label: string; href: string; external?: boolean };
type Row = { term: string; value?: string; links?: Link[] };

const info: Row[] = [
  { term: footer.info.companyName, value: business.companyName },
  { term: footer.info.representative, value: business.representative },
  { term: footer.info.address, value: business.address },
  { term: footer.info.email, links: [{ label: business.email, href: `mailto:${business.email}` }] },
  { term: footer.info.phone, links: [{ label: business.phone, href: `tel:${business.phone}` }] },
  // One row for every chat channel, so a second channel doesn't repeat the label.
  {
    term: footer.info.chat,
    links: inquiryChannels.map((channel) => ({ label: channel.name, href: channel.href, external: true })),
  },
];
---

<footer>
  <div class="grid container">
    <div>
      <a href="/" class="logo" aria-label={header.homeLabel(site.name, site.nameLatin)}>
        <Image src={logo} alt={`${site.name} ${site.nameLatin}`} height={112} densities={[1, 2]} />
      </a>
      <dl class="info">
        {
          info.map((row) => (
            <>
              <dt>{row.term}</dt>
              <dd>
                {row.links
                  ? row.links.map((link, i) => (
                      <>
                        {i > 0 && <span class="sep" aria-hidden="true">·</span>}
                        {link.external ? (
                          <a href={link.href} target="_blank" rel="noopener">
                            {link.label}<span class="visually-hidden">{inquiryCta.newWindow}</span>
                          </a>
                        ) : (
                          <a href={link.href}>{link.label}</a>
                        )}
                      </>
                    ))
                  : row.value}
              </dd>
            </>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="bottom">
    <div class="bottom__inner container">
      <span>{footer.copyright(2026, site.nameLatin)}</span>
      <span class="bottom__place">{footer.place}</span>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--space-section);
    border-top: var(--border-hairline);
    background: var(--surface);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-lg);
    padding-top: var(--space-section-sm);
    padding-bottom: clamp(28px, 3vw, 44px);
  }

  .logo :global(img) {
    height: var(--logo-height-footer);
    width: auto;
  }

  .info {
    margin-top: 26px;
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 11px 0;
    font-size: var(--text-ui);
    letter-spacing: var(--tracking-ui);
  }

  .info dt {
    color: var(--text-secondary);
  }

  .info dd {
    color: var(--text-strong);
  }

  .sep {
    margin-inline: var(--space-2);
    color: var(--text-tertiary);
  }


  .bottom {
    border-top: var(--border-hairline);
  }

  .bottom__inner {
    padding-block: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-meta);
  }

  .bottom__place {
    letter-spacing: var(--tracking-step);
  }
</style>
