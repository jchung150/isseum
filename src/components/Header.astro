---
import { Image } from 'astro:assets';
import logo from '../assets/isseum-logo.png';
import { nav, bookingUrl, site } from '../config/site';
import Button from './Button.astro';

---

<header>
  <div class="bar container">
    <a href="/" class="logo" aria-label={`${site.name} ${site.nameLatin} 홈`}>
      <Image src={logo} alt={`${site.name} ${site.nameLatin}`} height={144} densities={[1, 2]} loading="eager" />
    </a>

    <nav class="gnb" aria-label="주요 메뉴">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="gnb__link"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <Button href={bookingUrl} variant="primary" size="md">대관 예약하기</Button>
  </div>

  <nav class="tabs" aria-label="주요 메뉴 (모바일)">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class="tabs__link"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg-sticky);
    backdrop-filter: var(--backdrop-blur);
    border-bottom: var(--border-hairline);
  }

  .bar {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo :global(img) {
    height: var(--logo-height);
    width: auto;
  }

  /* Desktop nav — hidden below the 900px breakpoint, where .tabs takes over. */
  .gnb {
    display: none;
    align-items: center;
    gap: var(--gap-md);
  }

  .gnb__link {
    font-size: var(--text-nav);
    font-weight: 500;
    letter-spacing: var(--tracking-ui);
  }

  /* Mobile: a horizontally-scrolling tab strip, not a hamburger.
     Better for a 4-item nav — see design/COMPONENTS.md §14. */
  .tabs {
    display: flex;
    border-top: var(--border-hairline);
    overflow-x: auto;
  }

  .tabs__link {
    flex: 1;
    text-align: center;
    padding: var(--space-3) 6px;
    font-size: var(--text-meta);
    font-weight: 500;
    white-space: nowrap;
  }

  .tabs__link + .tabs__link {
    border-left: var(--border-hairline);
  }

  @media (min-width: 900px) {
    .gnb {
      display: flex;
    }
    .tabs {
      display: none;
    }
  }
</style>

<script>
  // The sticky header is 101px on desktop but taller on mobile, where the tab
  // strip sits under the bar. Anchor offsets depend on it, so measure rather
  // than hard-code two numbers that drift apart.
  const header = document.querySelector('header');
  if (header) {
    const sync = () =>
      document.documentElement.style.setProperty(
        '--header-h',
        `${Math.round(header.getBoundingClientRect().height)}px`,
      );
    sync();
    new ResizeObserver(sync).observe(header);
  }
</script>
