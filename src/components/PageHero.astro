---
/** Subpage masthead: eyebrow + h1 + lead, closed by the emphasis rule. design/COMPONENTS.md §3. */
interface Props {
  eyebrow: string;
  title: string;
  /** Single-paragraph lead. For more than one paragraph use the `lead` slot. */
  lead?: string;
  meta?: string;
}

const { eyebrow, title, lead, meta }: Props = Astro.props;

// The slot wins over the prop; either may be used, so check both.
const hasLead = Boolean(lead) || Astro.slots.has('lead');
---

<section class="container hero">
  <p class="eyebrow hero__eyebrow">{eyebrow}</p>
  <h1 class="display hero__title">{title}</h1>
  <div class="hero__foot">
    {
      hasLead && (
        <div class="hero__lead">
          <slot name="lead">
            <p class="lead">{lead}</p>
          </slot>
        </div>
      )
    }
    {meta && <p class="hero__meta">{meta}</p>}
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-section-sm);
  }

  .hero__eyebrow {
    margin-bottom: clamp(18px, 2.6vw, 32px);
  }

  .hero__title {
    font-size: var(--display-page);
    line-height: 1.22;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: clamp(20px, 2.6vw, 34px);
    padding-bottom: clamp(20px, 2.6vw, 32px);
    border-bottom: var(--border-emphasis);
  }

  .hero__lead {
    max-width: var(--measure-body);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .hero__meta {
    font-size: var(--text-meta);
    color: var(--text-secondary);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
</style>
