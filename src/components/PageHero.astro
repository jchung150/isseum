---
/** Subpage masthead: eyebrow + h1 + lead, closed by the emphasis rule. design/COMPONENTS.md §3. */
interface Props {
  eyebrow: string;
  title: string;
  /** Single-paragraph lead. For more than one paragraph use the `lead` slot. */
  lead?: string;
  meta?: string;
  /**
   * Drops the 42em measure so a short lead can run the full container width.
   * Only for leads that are one or two sentences — the measure is there for a
   * reason on anything longer.
   */
  wideLead?: boolean;
}

const { eyebrow, title, lead, meta, wideLead = false }: Props = Astro.props;

// The slot wins over the prop; either may be used, so check both.
const hasLead = Boolean(lead) || Astro.slots.has('lead');
---

<section class="container hero" data-page-hero>
  <p class="eyebrow hero__eyebrow">{eyebrow}</p>
  <h1 class="display hero__title">{title}</h1>
  <div class="hero__foot">
    {
      hasLead && (
        <div class:list={['hero__lead', wideLead && 'hero__lead--wide']}>
          <slot name="lead">
            <p class="lead">{lead}</p>
          </slot>
        </div>
      )
    }
    {meta && <p class="hero__meta">{meta}</p>}
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-section-sm);
  }

  .hero__eyebrow {
    margin-bottom: clamp(18px, 2.6vw, 32px);
  }

  .hero__title {
    font-size: var(--display-page);
    line-height: 1.22;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: clamp(20px, 2.6vw, 34px);
    padding-bottom: clamp(20px, 2.6vw, 32px);
    border-bottom: var(--border-emphasis);
  }

  .hero__lead {
    /* The fluid lead size is declared here as well as on .lead, so the em-based
       max-width resolves against the growing type rather than the 16px root.
       Without this the measure is pinned at 576px and the paragraph appears to
       shrink as the viewport widens. */
    font-size: var(--text-lead);
    max-width: var(--measure-hero-lead);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Doubled class so it outranks .hero__lead regardless of source order. */
  .hero__lead.hero__lead--wide {
    max-width: none;
  }

  .hero__meta {
    font-size: var(--text-meta);
    color: var(--text-secondary);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
</style>
