---
/**
 * Category filter. A real <button> group with roving state.
 * design/COMPONENTS.md §9.
 */
interface Props {
  categories: readonly string[];
  /** Element id of the list this controls, for aria-controls. */
  controls: string;
  label: string;
}

const { categories, controls, label } = Astro.props;
---

<div class="chips" role="group" aria-label={label}>
  {
    categories.map((category, i) => (
      <button
        type="button"
        class:list={['chip', { 'is-active': i === 0 }]}
        data-filter-value={category}
        aria-pressed={i === 0 ? 'true' : 'false'}
        aria-controls={controls}
      >
        {category}
      </button>
    ))
  }
</div>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    border: var(--border-hairline);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-ui-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-body);
    padding: 10px 19px;
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .chip:hover {
    border-color: var(--ink);
  }

  .chip.is-active {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
  }
</style>
