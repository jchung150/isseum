---
import { content } from '../../data';
import type { Lang } from '../../data/i18n';

interface Props {
  lang: Lang;
}

const { stats } = content[Astro.props.lang].home;
---

<div class="stats-band">
  <dl class="wrap stats">
    {
      stats.map((stat) => (
        <div>
          <dt>{stat.label}</dt>
          <dd>{stat.value}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .stats-band {
    background: var(--mist);
    border-block: var(--rule) solid var(--ink);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 0;
    padding-block: 40px;
    text-align: center;
  }

  @media (min-width: 900px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Value reads first, label under it; the dt stays first in source for meaning. */
  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    min-width: 0;
    padding-inline: var(--space-3);
  }

  .stats > div + div {
    border-left: var(--rule) solid var(--rule-soft);
  }

  @media (max-width: 899px) {
    .stats > div:nth-child(3) {
      border-left: 0;
    }
  }

  dd {
    font-size: var(--type-stat);
    font-weight: 900;
    letter-spacing: var(--track-title);
    line-height: var(--lead-tight);
  }

  dt {
    color: var(--muted);
    font-size: var(--type-stat-label);
  }
</style>
