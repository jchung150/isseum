---
/**
 * 404, shared by /404 and /en/404. The header menu is the way out, so the page
 * is just the message and a home button. Cloudflare's
 * `not_found_handling: "404-page"` serves the nearest 404.html up the path, so a
 * miss under /en/ gets the English one.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from './PageHead.astro';
import { content } from '../../data';
import { localePath, type Lang } from '../../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { notFound } = content[lang];
---

<BaseLayout lang={lang} title={notFound.title} description={notFound.description} noindex>
  <div class="wrap nf">
    <PageHead id="nf-title" eyebrow={notFound.eyebrow} title={notFound.heading} lead={notFound.lead} />
    <a class="pill pill--solid" href={localePath(lang)}><span aria-hidden="true">←</span>&nbsp;{notFound.home}</a>
  </div>
</BaseLayout>

<style>
  /* Enough height that the footer doesn't ride up under a short message. */
  .nf {
    display: grid;
    align-content: start;
    justify-items: start;
    min-height: 60vh;
    padding-bottom: var(--space-hero-bottom);
  }
</style>
