# Cloudflare Pages / Netlify header rules.
# Served verbatim from public/; ignored by other hosts.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Astro content-hashes everything under /_astro/, so it can never go stale.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate or content edits won't appear after a deploy.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Unhashed files in public/ — cache briefly, not forever.
/og-image.jpg
  Cache-Control: public, max-age=86400
/favicon-16.png
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
